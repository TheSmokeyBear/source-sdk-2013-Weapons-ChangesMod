+	CBaseViewModel *pVM0 = pOwner->GetViewModel( 0, false );
+	CBaseViewModel *pVM1 = pOwner->GetViewModel( 1, false );
+	if ( !pVM0 || !pVM1 || pVM0->GetOwningWeapon() != this )
+		return;
