+ConVar tf_mod_shockwave_radius( "tf_mod_shockwave_radius", "400", FCVAR_NOTIFY, "Bear Feet: shockwave radius (units) for the biggest falls." );
+ConVar tf_mod_shockwave_force( "tf_mod_shockwave_force", "900", FCVAR_NOTIFY, "Bear Feet: shockwave push strength for the biggest falls." );
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: Bear Feet landing shockwave. Stronger and wider the faster the
+// fall; enemies in the open get thrown up and away, walls block it.
+//-----------------------------------------------------------------------------
+//-----------------------------------------------------------------------------
+// MOD: "mod stomp from any height" - landing on an enemy too gently to take fall damage
+// still stomps them. Same damage formula as the normal (Mantreads) stomp: what the fall
+// would have done to you, x3, +10, then "mod stomp damage multiplier".
+//-----------------------------------------------------------------------------
+void CTFPlayer::Mod_LowFallStomp( CTFPlayer *pOther, float flFallSpeed )
+{
+	if ( !pOther || !pOther->IsAlive() || pOther->GetTeamNumber() == GetTeamNumber() || !IsAlive() )
+		return;
+
+	if ( !m_Shared.CanFallStomp() )
+		return;
+
+	const float flFallDamage = 5.f * ( flFallSpeed / 300.f ) * ( (float)GetMaxHealth() / 100.f );
+	float flStompDamage = 10.f + flFallDamage * 3.f;
+	CALL_ATTRIB_HOOK_FLOAT_ON_OTHER( this, flStompDamage, mod_stomp_damage_mult );
+
+	CTakeDamageInfo info( this, this, GetActiveTFWeapon(), flStompDamage, DMG_FALL, TF_DMG_CUSTOM_BOOTS_STOMP );
+	pOther->TakeDamage( info );
+
+	EmitSound( "Weapon_Mantreads.Impact" );
+	EmitSound( "Player.FallDamageDealt" );
+	UTIL_ScreenShake( pOther->WorldSpaceCenter(), 15.0, 150.0, 1.0, 500, SHAKE_START );
+}
+
+static void Mod_LandingShockwave( CTFPlayer *pPlayer, float flFallSpeed, float flStrength )
+{
+	if ( !pPlayer || !TFGameRules() )
+		return;
+
+	// 0.5 power at the first fall that hurts, full power at twice that speed.
+	const float flPower = RemapValClamped( flFallSpeed, PLAYER_MAX_SAFE_FALL_SPEED, PLAYER_MAX_SAFE_FALL_SPEED * 2.f, 0.5f, 1.f );
+	const float flRadius = tf_mod_shockwave_radius.GetFloat() * flPower;
+	const float flForce = tf_mod_shockwave_force.GetFloat() * flPower * flStrength;
+	const Vector vecCenter = pPlayer->GetAbsOrigin();
+
+	if ( !( TFGameRules()->IsTruceActive() && pPlayer->IsTruceValidForEnt() ) )
+	{
+		CUtlVector< CTFPlayer * > vecEnemies;
+		CollectPlayers( &vecEnemies, GetEnemyTeam( pPlayer->GetTeamNumber() ), COLLECT_ONLY_LIVING_PLAYERS );
+		FOR_EACH_VEC( vecEnemies, i )
+		{
+			CTFPlayer *pEnemy = vecEnemies[i];
+			Vector vecTo = pEnemy->WorldSpaceCenter() - vecCenter;
+			const float flDist = vecTo.Length();
+			if ( flDist > flRadius )
+				continue;
+
+			trace_t tr;
+			UTIL_TraceLine( pPlayer->WorldSpaceCenter(), pEnemy->WorldSpaceCenter(), MASK_SOLID_BRUSHONLY, pPlayer, COLLISION_GROUP_NONE, &tr );
+			if ( tr.fraction < 1.f )
+				continue;
+
+			// Up and away, weaker at the edge.
+			Vector vecPush = vecTo;
+			vecPush.z = 0.f;
+			if ( vecPush.NormalizeInPlace() < 1.f )
+			{
+				vecPush = Vector( 1.f, 0.f, 0.f );
+			}
+			vecPush.z = 0.75f;
+			vecPush *= flForce * RemapValClamped( flDist, 0.f, flRadius, 1.f, 0.4f );
+
+			pEnemy->SetGroundEntity( NULL );
+			pEnemy->ApplyAbsVelocityImpulse( vecPush );
+			pEnemy->m_Shared.AddCond( TF_COND_KNOCKED_INTO_AIR );
+			pEnemy->m_AchievementData.AddDamagerToHistory( pPlayer );	// credit if they fall to their death
+		}
+	}
+
+	DispatchParticleEffect( "hammer_impact_button", vecCenter, vec3_angle );
+	pPlayer->EmitSound( "Weapon_Mantreads.Impact" );
+	UTIL_ScreenShake( vecCenter, 12.f * flPower, 150.f, 1.f, flRadius * 1.5f, SHAKE_START );
+}
