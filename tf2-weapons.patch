+//-----------------------------------------------------------------------------
+// Purpose: MOD: dual wield. The first-person weapon model is a separate entity
+// bone-merged onto the viewmodel's hands. Keep a second copy on viewmodel 1.
+//-----------------------------------------------------------------------------
+void CTFWeaponBase::Mod_UpdateDualAttachment( void )
+{
+	C_BaseAnimating *pMain = m_hViewmodelAttachment.Get();
+	C_BasePlayer *pOwner = ToBasePlayer( GetOwnerEntity() );
+	C_BaseViewModel *pVM1 = pOwner ? pOwner->GetViewModel( 1, false ) : NULL;
+
+	if ( pMain && pMain->GetModel() && pVM1 && !m_bDisguiseWeapon && Mod_IsDualWield() )
+	{
+		if ( !m_hModDualAttachment )
+		{
+			C_ViewmodelAttachmentModel *pEnt = new class C_ViewmodelAttachmentModel;
+			if ( !pEnt )
+				return;
+
+			pEnt->SetOuter( this );
+			pEnt->Mod_SetMirrored( true );
+			if ( pEnt->InitializeAsClientEntity( modelinfo->GetModelName( pMain->GetModel() ), RENDER_GROUP_VIEW_MODEL_OPAQUE ) == false )
+				return;
+
+			m_hModDualAttachment = pEnt;
+			m_hModDualAttachment->SetParent( pVM1 );
+			m_hModDualAttachment->SetLocalOrigin( vec3_origin );
+			m_hModDualAttachment->UpdatePartitionListEntry();
+			m_hModDualAttachment->CollisionProp()->UpdatePartition();
+			m_hModDualAttachment->UpdateVisibility();
+		}
+		else if ( m_hModDualAttachment->GetMoveParent() != pVM1 )
+		{
+			m_hModDualAttachment->SetParent( pVM1 );
+			m_hModDualAttachment->SetLocalOrigin( vec3_origin );
+		}
+
+		m_hModDualAttachment->m_nSkin = pMain->m_nSkin;
+		return;
+	}
+
+	if ( m_hModDualAttachment )
+	{
+		m_hModDualAttachment->Release();
+		m_hModDualAttachment = NULL;
+	}
+}
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: dual wield. When viewmodel 1 (the left hand) draws, draw the
+// left-hand copy of the weapon on it instead of the right-hand one.
+//-----------------------------------------------------------------------------
+int CTFWeaponBase::DrawOverriddenViewmodel( C_BaseViewModel *pViewmodel, int flags )
+{
+	if ( pViewmodel && pViewmodel->ViewModelIndex() == 1 && m_nViewModelIndex == 0 )
+	{
+		if ( !m_hModDualAttachment || !m_hViewmodelAttachment )
+		{
+			return pViewmodel->DrawOverriddenViewmodel( flags );	// arms only
+		}
+
+		CHandle<C_BaseAnimating> hMain = m_hViewmodelAttachment;
+		m_hModDualAttachment->m_nSkin = hMain->m_nSkin;
+		m_hViewmodelAttachment = m_hModDualAttachment.Get();
+		int ret = BaseClass::DrawOverriddenViewmodel( pViewmodel, flags );
+		m_hViewmodelAttachment = hMain;
+		return ret;
+	}
+
+	return BaseClass::DrawOverriddenViewmodel( pViewmodel, flags );
+}
