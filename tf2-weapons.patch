+#if defined( TF_DLL ) || defined( TF_CLIENT_DLL )
+//-----------------------------------------------------------------------------
+// MOD: Custom item support.
+//
+// Valve's scripts/items/items_game.txt is loaded from the player's TF2 install and
+// is signature-checked, so we never edit it. Instead, anything in our mod's
+// scripts/items/items_mod.txt is merged on top of it at load time:
+//
+//   "items_mod"
+//   {
+//       "attributes" { "<index>" { ...same format as items_game... } }
+//       "items"
+//       {
+//           "<index>"
+//           {
+//               "mod_copy_from"  "<existing item index>"   // optional
+//               ...keys...
+//           }
+//       }
+//   }
+//
+// "mod_copy_from" clones an existing item (flattened through its prefabs, so it
+// keeps the model, sounds, animations and visuals) and strips its attributes,
+// base-item flag and set membership. Every other key you give replaces the
+// copied key of the same name entirely (blocks are replaced, not merged).
+//-----------------------------------------------------------------------------
+#define MOD_ITEMS_FILE "scripts/items/items_mod.txt"
+
+static void Mod_RemoveAllKeysNamed( KeyValues *pKV, const char *pszName )
+{
+	KeyValues *pKey;
+	while ( ( pKey = pKV->FindKey( pszName ) ) != NULL )
+	{
+		pKV->RemoveSubKey( pKey );
+		pKey->deleteThis();
+	}
+}
+
+static void Mod_MergeBlockByName( KeyValues *pDest, KeyValues *pSrc )
+{
+	if ( !pDest || !pSrc )
+		return;
+
+	FOR_EACH_TRUE_SUBKEY( pSrc, pEntry )
+	{
+		Mod_RemoveAllKeysNamed( pDest, pEntry->GetName() );
+		pDest->AddSubKey( pEntry->MakeCopy() );
+	}
+}
+
+void MergeDefinitionPrefab( KeyValues *pKVWriteItem, KeyValues *pKVSourceItem );
+
+static void Mod_MergeCustomItems( KeyValues *pKVRawDefinition )
+{
+	KeyValues *pKVMod = new KeyValues( "items_mod" );
+	if ( !pKVMod->LoadFromFile( g_pFullFileSystem, MOD_ITEMS_FILE, "MOD" ) )
+	{
+		pKVMod->deleteThis();
+		return;
+	}
+
+	int nAttribs = 0, nItems = 0;
+
+	// Attributes: straight add/replace by index.
+	KeyValues *pModAttribs = pKVMod->FindKey( "attributes" );
+	if ( pModAttribs )
+	{
+		Mod_MergeBlockByName( pKVRawDefinition->FindKey( "attributes", true ), pModAttribs );
+		FOR_EACH_TRUE_SUBKEY( pModAttribs, pAttr ) { ++nAttribs; }
+	}
+
+	// Items: optionally cloned from an existing item, then overlaid.
+	KeyValues *pModItems = pKVMod->FindKey( "items" );
+	if ( pModItems )
+	{
+		KeyValues *pItems = pKVRawDefinition->FindKey( "items", true );
+
+		FOR_EACH_TRUE_SUBKEY( pModItems, pModItem )
+		{
+			KeyValues *pNewItem = new KeyValues( pModItem->GetName() );
+
+			const char *pszCopyFrom = pModItem->GetString( "mod_copy_from", NULL );
+			if ( pszCopyFrom && *pszCopyFrom )
+			{
+				KeyValues *pSource = pItems->FindKey( pszCopyFrom );
+				if ( pSource )
+				{
+					MergeDefinitionPrefab( pNewItem, pSource );
+
+					// Don't inherit identity or stats from the source item.
+					Mod_RemoveAllKeysNamed( pNewItem, "prefab" );
+					Mod_RemoveAllKeysNamed( pNewItem, "baseitem" );
+					Mod_RemoveAllKeysNamed( pNewItem, "attributes" );
+					Mod_RemoveAllKeysNamed( pNewItem, "static_attrs" );
+					Mod_RemoveAllKeysNamed( pNewItem, "item_set" );
+					Mod_RemoveAllKeysNamed( pNewItem, "propername" );
+					Mod_RemoveAllKeysNamed( pNewItem, "xifier_class_remap" );
+				}
+				else
+				{
+					Warning( "%s: item %s copies from unknown item %s\n", MOD_ITEMS_FILE, pModItem->GetName(), pszCopyFrom );
+				}
+			}
+
+			FOR_EACH_SUBKEY( pModItem, pKey )
+			{
+				if ( !V_stricmp( pKey->GetName(), "mod_copy_from" ) )
+					continue;
+
+				Mod_RemoveAllKeysNamed( pNewItem, pKey->GetName() );
+				pNewItem->AddSubKey( pKey->MakeCopy() );
+			}
+
+			Mod_RemoveAllKeysNamed( pItems, pModItem->GetName() );
+			pItems->AddSubKey( pNewItem );
+			++nItems;
+		}
+	}
+
+	DevMsg( "%s: merged %d attributes and %d items\n", MOD_ITEMS_FILE, nAttribs, nItems );
+	pKVMod->deleteThis();
+}
