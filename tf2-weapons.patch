 	bool bTruce = TFGameRules() && TFGameRules()->IsTruceActive() && pPlayer->IsTruceValidForEnt();
 	if ( !bTruce )
 	{
+		// MOD: "mod melee airblast knockback" - the hit launches the victim like a Pyro
+		// airblast, with the push strength multiplied by the attribute value.
+		float flAirblastKnockback = 0.f;
+		CALL_ATTRIB_HOOK_FLOAT( flAirblastKnockback, mod_melee_airblast_knockback );
+		if ( flAirblastKnockback > 0.f )
+		{
+			CTFPlayer *pVictimPlayer = ToTFPlayer( ent );
+			if ( pVictimPlayer && pVictimPlayer->IsAlive() && !pVictimPlayer->InSameTeam( pPlayer ) && !pVictimPlayer->m_Shared.IsImmuneToPushback() )
+			{
+				// Same direction rule as airblast: our aim pitch, turned to face the victim.
+				Vector vecToVictim = pVictimPlayer->WorldSpaceCenter() - pPlayer->WorldSpaceCenter();
+				QAngle angToVictim;
+				VectorAngles( vecToVictim, angToVictim );
+				QAngle angPush = pPlayer->EyeAngles();
+				angPush[YAW] = angToVictim[YAW];
+				Vector vecPushDir;
+				AngleVectors( angPush, &vecPushDir );
+
+				Vector vecForce = vecPushDir * ( tf_airblast_cray_power.GetFloat() * flAirblastKnockback );
+
+				// Grounded victims always get lifted, like airblast's ground bounce.
+				const float flMinUp = tf_airblast_cray_ground_minz.GetFloat() * flAirblastKnockback;
+				if ( ( pVictimPlayer->GetFlags() & FL_ONGROUND ) && vecForce.z < flMinUp )
+				{
+					vecForce.z = flMinUp;
+				}
+
+				pVictimPlayer->ApplyPunchImpulseX( RandomInt( 10, 15 ) );
+				pVictimPlayer->RemoveFlag( FL_ONGROUND );
+				pVictimPlayer->SetGroundEntity( NULL );
+				const float flLoseFooting = tf_airblast_cray_lose_footing_duration.GetFloat();
+				if ( flLoseFooting > 0.f )
+				{
+					pVictimPlayer->m_Shared.AddCond( TF_COND_LOST_FOOTING, flLoseFooting );
+				}
+				pVictimPlayer->m_Shared.AddCond( TF_COND_AIR_CURRENT );
+				pVictimPlayer->m_Shared.AddCond( TF_COND_KNOCKED_INTO_AIR );
+				pVictimPlayer->ApplyAbsVelocityImpulse( vecForce );
+			}
+		}
+
 		int iCritsForceVictimToLaugh = 0;
 		CALL_ATTRIB_HOOK_INT( iCritsForceVictimToLaugh, crit_forces_victim_to_laugh );
 		if ( iCritsForceVictimToLaugh > 0 && ( IsCurrentAttackACrit() || iDmgType & DMG_CRITICAL ) )
