+//-----------------------------------------------------------------------------
+// Purpose: MOD: put the left gun (viewmodel 1) on the same animation as the right gun.
+//-----------------------------------------------------------------------------
+void CTFWeaponBase::Mod_SyncDualViewModel( void )
+{
+#if defined( CLIENT_DLL )
+	if ( !IsPredicted() )
+		return;
+#endif
+
+	CBasePlayer *pOwner = ToBasePlayer( GetOwner() );
+	if ( !pOwner )
+		return;
+
+	CBaseViewModel *pVM0 = pOwner->GetViewModel( 0, false );
+	CBaseViewModel *pVM1 = pOwner->GetViewModel( 1, false );
+	if ( !pVM0 || !pVM1 || pVM0->GetOwningWeapon() != this )
+		return;
+
+#ifdef GAME_DLL
+	// CTFPlayer::Spawn blanks viewmodel 1 with SetModel(""), which SetWeaponModel doesn't
+	// notice; clear its remembered name so the arms model gets set again.
+	if ( !STRING( pVM1->GetModelName() )[0] )
+	{
+		pVM1->SetWeaponModel( NULL, NULL );
+	}
+#endif
+
+	// Same arms model as the right hand (SetViewModel uses m_nViewModelIndex).
+	m_nViewModelIndex = 1;
+	SetViewModel();
+	m_nViewModelIndex = 0;
+
+	// Visibility is handled by the model: Mod_HideDualViewModel clears it on holster.
+	pVM1->RemoveEffects( EF_NODRAW );
+
+	if ( pVM0->GetSequence() >= 0 )
+	{
+		pVM1->SendViewModelMatchingSequence( pVM0->GetSequence() );
+	}
+	pVM1->SetPlaybackRate( pVM0->GetPlaybackRate() );
+}
