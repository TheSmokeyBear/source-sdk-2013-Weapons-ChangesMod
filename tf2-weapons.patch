+static CUtlString Mod_ClassList( GameItemDefinition_t *pDef );
+
+// Fake, never-reused item IDs well outside the range of real Steam item IDs.
+static itemid_t s_ulNextModItemID = MOD_FAKE_ITEMID_BASE;
+
+static void Mod_PrecacheItemModels( const GameItemDefinition_t *pDef )
+{
+	CUtlVector< const char * > vecModels;
+	pDef->GeneratePrecacheModelStrings( false, &vecModels );
+	FOR_EACH_VEC( vecModels, i )
+	{
+		if ( vecModels[i] && *vecModels[i] )
+			CBaseEntity::PrecacheModel( vecModels[i] );
+	}
+}
+
+// Builds a local copy of an item with the chosen quality and extras (Australium, Unusual, ...).
+static bool Mod_BuildItemView( CEconItemView &item, const CTFPlayer::ModEquip_t &equip, bool bTaunt )
+{
+	// Pick the quality: explicit, else Unusual/Strange if asked for, else Unique.
+	// (Normal quality would make the game match items by type instead of by ID.)
+	int iQuality = equip.m_nQuality;
+	if ( iQuality < 0 || iQuality == AE_NORMAL )
+	{
+		iQuality = equip.m_nUnusual ? AE_UNUSUAL : AE_UNIQUE;
+	}
+
+	item.Init( equip.m_iDef, iQuality, AE_USE_SCRIPT_VALUE, false );
+	if ( !item.GetStaticData() )
+		return false;
+	item.SetItemID( s_ulNextModItemID++ );
+
+	if ( equip.m_bAustralium )
+	{
+		Mod_SetRuntimeAttr( item, "is australium item", 1.f );
+		Mod_SetRuntimeAttr( item, "item style override", 1.f );
+	}
+	if ( equip.m_nStyle >= 0 )
+		Mod_SetRuntimeAttr( item, "item style override", (float)equip.m_nStyle );
+	if ( equip.m_bFestive )
+		Mod_SetRuntimeAttr( item, "is_festivized", 1.f );
+	if ( equip.m_nUnusual > 0 )
+	{
+		// Taunts use their own unusual attribute.
+		Mod_SetRuntimeAttr( item, bTaunt ? "taunt attach particle index" : "attach particle effect", (float)equip.m_nUnusual );
+	}
+	if ( equip.m_nKillstreakTier > 0 )
+		Mod_SetRuntimeAttr( item, "killstreak tier", (float)equip.m_nKillstreakTier );
+	if ( equip.m_nSheen > 0 )
+		Mod_SetRuntimeAttr( item, "killstreak idleeffect", (float)equip.m_nSheen );
+	if ( equip.m_nKillstreaker > 0 )
+		Mod_SetRuntimeAttr( item, "killstreak effect", (float)equip.m_nKillstreaker );
+	if ( iQuality == AE_STRANGE )
+		Mod_SetRuntimeAttr( item, "kill eater", 0.f );
+
+	return true;
+}
+
+bool CTFPlayer::Mod_SetItem( int iClass, int iSlot, const ModEquip_t &equip )
+{
+	if ( !Mod_BuildItemView( m_ModEquippedItems[iClass][iSlot], equip, IsTauntSlot( iSlot ) ) )
+	{
+		m_ModEquips[iClass][iSlot].Clear();
+		return false;
+	}
+
+	m_ModEquips[iClass][iSlot] = equip;
+	return true;
+}
+
+//-----------------------------------------------------------------------------
+// MOD: extra weapons. Carried on top of the normal loadout, on number key
+// m_nExtraKey; several can share a key (pressing it again cycles through them).
+//-----------------------------------------------------------------------------
+static int Mod_GetExtraKeyFromDef( const GameItemDefinition_t *pDef )
+{
+	static CSchemaAttributeDefHandle pAttrDef_ExtraWeapon( "mod extra weapon" );
+	float flKey = 0.f;
+	if ( pDef && FindAttribute_UnsafeBitwiseCast<attrib_value_t>( pDef, pAttrDef_ExtraWeapon, &flKey ) )
+		return (int)flKey;
+	return 0;
+}
+
+bool CTFPlayer::Mod_SetExtra( int iClass, int iIndex, const ModEquip_t &equip )
+{
+	CEconItemView &item = m_ModExtraItems[iClass][iIndex];
+	if ( !Mod_BuildItemView( item, equip, false ) )
+	{
+		m_ModExtraEquips[iClass][iIndex].Clear();
+		return false;
+	}
+
+	// Which number key, and a spot after the normal weapons on that key (runtime values
+	// override the item's own, and travel to clients with the weapon).
+	Mod_SetRuntimeAttr( item, "mod extra weapon", (float)equip.m_nExtraKey );
+	Mod_SetRuntimeAttr( item, "mod weapon position", (float)( 5 + iIndex ) );
+
+	m_ModExtraEquips[iClass][iIndex] = equip;
+	return true;
+}
+
+CEconItemView *CTFPlayer::Mod_GetExtraItem( int iClass, int iIndex )
+{
+	if ( !m_bModEquipsRestored )
+	{
+		Mod_RestoreSavedEquips();
+	}
+
+	if ( iClass < 0 || iClass >= TF_CLASS_COUNT_ALL || iIndex < 0 || iIndex >= MOD_MAX_EXTRA_WEAPONS )
+		return NULL;
+
+	if ( m_ModExtraEquips[iClass][iIndex].m_iDef == INVALID_ITEM_DEF_INDEX )
+		return NULL;
+
+	CEconItemView *pItem = &m_ModExtraItems[iClass][iIndex];
+	return ( pItem->IsValid() && pItem->GetStaticData() ) ? pItem : NULL;
+}
+
+bool CTFPlayer::Mod_UnequipExtra( int iClass, int iIndex )
+{
+	if ( !Mod_GetExtraItem( iClass, iIndex ) )
+		return false;
+
+	m_ModExtraEquips[iClass][iIndex].Clear();
+	Mod_SaveEquips();
+	Mod_ApplyLoadoutChange( iClass );
+	return true;
+}
+
+bool CTFPlayer::Mod_IsCurrentExtraWeapon( CBaseCombatWeapon *pWeapon )
+{
+	CTFWeaponBase *pTFWeapon = dynamic_cast< CTFWeaponBase * >( pWeapon );
+	if ( !pTFWeapon || !GetPlayerClass() )
+		return false;
+
+	const itemid_t ulItemID = pTFWeapon->GetAttributeContainer()->GetItem()->GetItemID();
+	if ( ulItemID < MOD_FAKE_ITEMID_BASE || ulItemID == INVALID_ITEM_ID )
+		return false;
+
+	const int iClass = GetPlayerClass()->GetClassIndex();
+	for ( int i = 0; i < MOD_MAX_EXTRA_WEAPONS; ++i )
+	{
+		CEconItemView *pItem = Mod_GetExtraItem( iClass, i );
+		if ( pItem && pItem->GetItemID() == ulItemID )
+			return ItemIsAllowed( pItem );
+	}
+	return false;
+}
+
+void CTFPlayer::Mod_GiveExtraWeapons( void )
+{
+	if ( !GetPlayerClass() )
+		return;
+
+	const int iClass = GetPlayerClass()->GetClassIndex();
+	CSteamID ownerSteamID;
+	GetSteamID( &ownerSteamID );
+
+	for ( int i = 0; i < MOD_MAX_EXTRA_WEAPONS; ++i )
+	{
+		CEconItemView *pItem = Mod_GetExtraItem( iClass, i );
+		if ( !pItem || !pItem->GetStaticData()->CanBeUsedByClass( iClass ) || !ItemIsAllowed( pItem ) )
+			continue;
+
+		// Already carrying it (kept through a resupply)?
+		bool bHave = false;
+		for ( int w = 0; w < MAX_WEAPONS && !bHave; ++w )
+		{
+			CTFWeaponBase *pWeapon = dynamic_cast< CTFWeaponBase * >( GetWeapon( w ) );
+			bHave = pWeapon && pWeapon->GetAttributeContainer()->GetItem()->GetItemID() == pItem->GetItemID();
+		}
+		if ( bHave )
+			continue;
+
+		const char *pszItemClass = pItem->GetStaticData()->GetItemClass();
+		if ( !pszItemClass || !*pszItemClass || FStrEq( pszItemClass, "no_entity" ) )
+			continue;
+
+		pszItemClass = TranslateWeaponEntForClass( pszItemClass, iClass );
+		if ( !pszItemClass || !*pszItemClass )
+			continue;
+
+		// Made directly rather than with GiveNamedItem, which refuses a second weapon of a
+		// type you already carry (a second rocket launcher, say).
+		CBaseEntity *pEntity = ItemGeneration()->GenerateItemFromScriptData( pItem, GetLocalOrigin(), vec3_angle, pszItemClass );
+		CTFWeaponBase *pNewWeapon = dynamic_cast< CTFWeaponBase * >( pEntity );
+		if ( !pNewWeapon )
+		{
+			if ( pEntity )
+				UTIL_Remove( pEntity );
+			Warning( "mod_equip: %s can't be an extra weapon (not a weapon).\n", pItem->GetStaticData()->GetDefinitionName() );
+			continue;
+		}
+
+		pNewWeapon->AddSpawnFlags( SF_NORESPAWN );
+		DispatchSpawn( pNewWeapon );
+		if ( pNewWeapon->IsMarkedForDeletion() )
+			continue;
+
+		pNewWeapon->GetAttributeContainer()->GetItem()->SetOverrideAccountID( ownerSteamID.GetAccountID() );
+		pNewWeapon->SetSoundsEnabled( false );
+		pNewWeapon->AddSolidFlags( FSOLID_NOT_SOLID );
+		pNewWeapon->AddEffects( EF_NODRAW );
+		Weapon_Equip( pNewWeapon );
+		pNewWeapon->SetSoundsEnabled( true );
+	}
+}
+
+CEconItemView *CTFPlayer::Mod_GetItem( int iClass, int iSlot )
+{
+	if ( !m_bModEquipsRestored )
+	{
+		Mod_RestoreSavedEquips();
+	}
+
+	if ( iClass < 0 || iClass >= TF_CLASS_COUNT_ALL || iSlot < 0 || iSlot >= CLASS_LOADOUT_POSITION_COUNT )
+		return NULL;
+
+	if ( m_ModEquips[iClass][iSlot].m_iDef == INVALID_ITEM_DEF_INDEX )
+		return NULL;
+
+	CEconItemView *pItem = &m_ModEquippedItems[iClass][iSlot];
+	return ( pItem->IsValid() && pItem->GetStaticData() ) ? pItem : NULL;
+}
+
+CEconItemView *CTFPlayer::Mod_GetItemByID( itemid_t ulItemID )
+{
+	if ( ulItemID < MOD_FAKE_ITEMID_BASE || ulItemID == INVALID_ITEM_ID )
+		return NULL;
+
+	for ( int iClass = 0; iClass < TF_CLASS_COUNT_ALL; ++iClass )
+	{
+		for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+		{
+			CEconItemView *pItem = Mod_GetItem( iClass, iSlot );
+			if ( pItem && pItem->GetItemID() == ulItemID )
+				return pItem;
+		}
+		for ( int i = 0; i < MOD_MAX_EXTRA_WEAPONS; ++i )
+		{
+			CEconItemView *pItem = Mod_GetExtraItem( iClass, i );
+			if ( pItem && pItem->GetItemID() == ulItemID )
+				return pItem;
+		}
+	}
+	return NULL;
+}
+
+bool CTFPlayer::Mod_EquipItem( const ModEquip_t &equip )
+{
+	if ( !m_bModEquipsRestored )
+	{
+		Mod_RestoreSavedEquips();
+	}
+
+	GameItemDefinition_t *pDef = static_cast< GameItemDefinition_t * >( GetItemSchema()->GetItemDefinition( equip.m_iDef ) );
+	if ( !pDef )
+		return false;
+
+	if ( !Mod_CanEquipDef( equip.m_iDef ) )
+	{
+		ClientPrint( this, HUD_PRINTCONSOLE, "This server only allows the mod's custom items (tf_mod_allow_all_items is 0).\n" );
+		return false;
+	}
+
+	// Equip for the class we're playing if it can use the item, otherwise the first class that can.
+	int iClass = GetPlayerClass() ? GetPlayerClass()->GetClassIndex() : TF_CLASS_UNDEFINED;
+	if ( iClass < TF_FIRST_NORMAL_CLASS || iClass >= TF_LAST_NORMAL_CLASS || !pDef->CanBeUsedByClass( iClass ) )
+	{
+		iClass = TF_CLASS_UNDEFINED;
+		for ( int i = TF_FIRST_NORMAL_CLASS; i < TF_LAST_NORMAL_CLASS; ++i )
+		{
+			if ( pDef->CanBeUsedByClass( i ) )
+			{
+				iClass = i;
+				break;
+			}
+		}
+	}
+	if ( iClass == TF_CLASS_UNDEFINED )
+	{
+		ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "\"%s\" isn't something a class can hold or wear (tools, crates, etc.).\n", pDef->GetDefinitionName() ) );
+		return false;
+	}
+
+	int iSlot = pDef->GetLoadoutSlot( iClass );
+	if ( iSlot < 0 || iSlot >= CLASS_LOADOUT_POSITION_COUNT )
+		return false;
+
+	// MOD: an extra weapon, carried on top of the normal loadout?
+	const int iExtraKey = equip.m_nExtraKey ? equip.m_nExtraKey : Mod_GetExtraKeyFromDef( pDef );
+	if ( iExtraKey > 0 )
+	{
+		const char *pszItemClass = pDef->GetItemClass();
+		if ( IsTauntSlot( iSlot ) || pDef->GetTauntData() || IsWearableSlot( iSlot ) || !pszItemClass || FStrEq( pszItemClass, "no_entity" ) )
+		{
+			ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "%s isn't a weapon, so it can't be an extra weapon.\n", pDef->GetDefinitionName() ) );
+			return false;
+		}
+		if ( iExtraKey > MAX_WEAPON_SLOTS )
+		{
+			ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "Extra weapons go on number keys 1-%d.\n", MAX_WEAPON_SLOTS ) );
+			return false;
+		}
+
+		// Same item again just moves it; otherwise take the first free spot.
+		int iChosen = -1;
+		for ( int i = 0; i < MOD_MAX_EXTRA_WEAPONS && iChosen < 0; ++i )
+		{
+			if ( m_ModExtraEquips[iClass][i].m_iDef == equip.m_iDef )
+				iChosen = i;
+		}
+		for ( int i = 0; i < MOD_MAX_EXTRA_WEAPONS && iChosen < 0; ++i )
+		{
+			if ( m_ModExtraEquips[iClass][i].m_iDef == INVALID_ITEM_DEF_INDEX )
+				iChosen = i;
+		}
+		if ( iChosen < 0 )
+		{
+			ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "%s already has %d extra weapons. Remove one with mod_unequip first.\n", g_aPlayerClassNames_NonLocalized[iClass], (int)MOD_MAX_EXTRA_WEAPONS ) );
+			return false;
+		}
+
+		ModEquip_t extra = equip;
+		extra.m_nExtraKey = iExtraKey;
+		if ( !Mod_SetExtra( iClass, iChosen, extra ) )
+			return false;
+
+		Mod_SaveEquips();
+		Mod_PrecacheItemModels( pDef );
+		ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "Added %s for %s as an extra weapon on key %d (press it again to cycle).\n", pDef->GetDefinitionName(), g_aPlayerClassNames_NonLocalized[iClass], iExtraKey ) );
+		Mod_ApplyLoadoutChange( iClass );
+		return true;
+	}
+
+	// Taunts fill the eight taunt slots the same way cosmetics fill theirs.
+	const bool bTaunt = IsTauntSlot( iSlot ) || pDef->GetTauntData() != NULL;
+	if ( bTaunt )
+	{
+		int iChosen = -1;
+		for ( int i = LOADOUT_POSITION_TAUNT; i <= LOADOUT_POSITION_TAUNT8 && iChosen < 0; ++i )
+		{
+			if ( m_ModEquips[iClass][i].m_iDef == equip.m_iDef )
+				iChosen = i;
+		}
+		for ( int i = LOADOUT_POSITION_TAUNT; i <= LOADOUT_POSITION_TAUNT8 && iChosen < 0; ++i )
+		{
+			if ( m_ModEquips[iClass][i].m_iDef == INVALID_ITEM_DEF_INDEX )
+				iChosen = i;
+		}
+		iSlot = ( iChosen >= 0 ) ? iChosen : LOADOUT_POSITION_TAUNT8;
+
+		if ( !Mod_SetItem( iClass, iSlot, equip ) )
+			return false;
+		Mod_SaveEquips();
+
+		// Taunts need no entity, so make it usable right away for the current class.
+		if ( GetPlayerClass() && GetPlayerClass()->GetClassIndex() == iClass )
+		{
+			m_EquippedLoadoutItemIndices[iSlot] = m_ModEquippedItems[iClass][iSlot].GetItemID();
+		}
+		Mod_PrecacheItemModels( pDef );
+
+		const int iTauntNumber = iSlot - LOADOUT_POSITION_TAUNT + 1;
+		ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "Equipped %s for %s as taunt %d. Play it with: taunt %d\n", pDef->GetDefinitionName(), g_aPlayerClassNames_NonLocalized[iClass], iTauntNumber, iTauntNumber ) );
+		return true;
+	}
+
+	// Cosmetics share three slots: reuse the slot already holding this item, else the first
+	// free one, else replace the last.
+	if ( IsWearableSlot( iSlot ) )
+	{
+		static const int s_CosmeticSlots[] = { LOADOUT_POSITION_HEAD, LOADOUT_POSITION_MISC, LOADOUT_POSITION_MISC2 };
+		int iChosen = -1;
+		for ( int i = 0; i < ARRAYSIZE( s_CosmeticSlots ) && iChosen < 0; ++i )
+		{
+			if ( m_ModEquips[iClass][ s_CosmeticSlots[i] ].m_iDef == equip.m_iDef )
+				iChosen = s_CosmeticSlots[i];
+		}
+		for ( int i = 0; i < ARRAYSIZE( s_CosmeticSlots ) && iChosen < 0; ++i )
+		{
+			if ( m_ModEquips[iClass][ s_CosmeticSlots[i] ].m_iDef == INVALID_ITEM_DEF_INDEX )
+				iChosen = s_CosmeticSlots[i];
+		}
+		iSlot = ( iChosen >= 0 ) ? iChosen : LOADOUT_POSITION_MISC2;
+	}
+
+	if ( !Mod_SetItem( iClass, iSlot, equip ) )
+		return false;
+
+	Mod_SaveEquips();
+
+	ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "Equipped %s for %s (%s).\n", pDef->GetDefinitionName(), g_aPlayerClassNames_NonLocalized[iClass], Mod_SlotName( iSlot ) ) );
+	Mod_ApplyLoadoutChange( iClass );
+	return true;
+}
+
+bool CTFPlayer::Mod_UnequipItem( int iClass, int iSlot )
+{
+	if ( !Mod_GetItem( iClass, iSlot ) )
+		return false;
+
+	m_ModEquips[iClass][iSlot].Clear();
+	Mod_SaveEquips();
+	Mod_ApplyLoadoutChange( iClass );
+	return true;
+}
+
+// Plays any taunt straight away, without equipping it.
+bool CTFPlayer::Mod_PlayTaunt( const ModEquip_t &equip )
+{
+	GameItemDefinition_t *pDef = static_cast< GameItemDefinition_t * >( GetItemSchema()->GetItemDefinition( equip.m_iDef ) );
+	if ( !pDef || !pDef->GetTauntData() )
+	{
+		ClientPrint( this, HUD_PRINTCONSOLE, "That item isn't a taunt.\n" );
+		return false;
+	}
+
+	if ( !Mod_CanEquipDef( equip.m_iDef ) )
+	{
+		ClientPrint( this, HUD_PRINTCONSOLE, "This server only allows the mod's custom items (tf_mod_allow_all_items is 0).\n" );
+		return false;
+	}
+
+	const int iClass = GetPlayerClass() ? GetPlayerClass()->GetClassIndex() : TF_CLASS_UNDEFINED;
+	if ( !pDef->CanBeUsedByClass( iClass ) )
+	{
+		ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "%s can't do %s. Classes that can: %s\n", g_aPlayerClassNames_NonLocalized[ Max( iClass, 0 ) ], pDef->GetDefinitionName(), Mod_ClassList( pDef ).Get() ) );
+		return false;
+	}
+
+	if ( m_flTauntNextStartTime >= gpGlobals->curtime || !IsAllowedToTaunt() )
+		return false;
+
+	m_ModTauntItem.Init( equip.m_iDef, equip.m_nUnusual ? AE_UNUSUAL : AE_UNIQUE, AE_USE_SCRIPT_VALUE, false );
+	if ( !m_ModTauntItem.GetStaticData() )
+		return false;
+	m_ModTauntItem.SetItemID( s_ulNextModItemID++ );
+	if ( equip.m_nUnusual > 0 )
+		Mod_SetRuntimeAttr( m_ModTauntItem, "taunt attach particle index", (float)equip.m_nUnusual );
+
+	Mod_PrecacheItemModels( pDef );
+
+	m_nActiveTauntSlot = LOADOUT_POSITION_INVALID;
+	return PlayTauntSceneFromItem( &m_ModTauntItem );
+}
+
+void CTFPlayer::Mod_ApplyLoadoutChange( int iClass )
+{
+	if ( !IsAlive() || !GetPlayerClass() || GetPlayerClass()->GetClassIndex() != iClass )
+		return;
+
+	// Same rule as a normal loadout change: instant in your own spawn room,
+	// otherwise at the next resupply locker or respawn.
+	if ( PointInRespawnRoom( this, WorldSpaceCenter(), true ) )
+	{
+		ForceRegenerateAndRespawn();
+	}
+	else
+	{
+		ClientPrint( this, HUD_PRINTCENTER, "Loadout changed - visit a resupply locker or respawn to use it." );
+	}
+}
+
+//-----------------------------------------------------------------------------
+// MOD: the custom items the player has equipped in the loadout menu. The client sends
+// this when joining, on every map, and whenever the loadout changes:
+//   "mod_loadout" { "items" { "<class>" { "<slot>" "<item index>" } }
+//                   "touched" { "<class>" { "<slot>" "1" } } }
+// Items from the menu replace each other. Items given with mod_equip stay put unless the
+// player changed that same slot in the menu (picking a stock or Steam item there, say).
+//-----------------------------------------------------------------------------
+extern bool AreSlotsConsideredIdentical( EEquipType_t eEquipType, int iBaseSlot, int iTestSlot );	// tf_item_inventory.cpp
+
+void CTFPlayer::Mod_ApplyInventoryLoadout( KeyValues *pKV )
+{
+	if ( !pKV )
+		return;
+
+	if ( !m_bModEquipsRestored )
+	{
+		Mod_RestoreSavedEquips();
+	}
+
+	KeyValues *pItemsKV = pKV->FindKey( "items" );
+	KeyValues *pTouchedKV = pKV->FindKey( "touched" );
+	const int iCurrentClass = GetPlayerClass() ? GetPlayerClass()->GetClassIndex() : TF_CLASS_UNDEFINED;
+	bool bAnyChange = false;
+	bool bCurrentClassChanged = false;
+
+	for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS; ++iClass )
+	{
+		char szClass[16];
+		V_snprintf( szClass, sizeof( szClass ), "%d", iClass );
+		KeyValues *pClassItems = pItemsKV ? pItemsKV->FindKey( szClass ) : NULL;
+		KeyValues *pClassTouched = pTouchedKV ? pTouchedKV->FindKey( szClass ) : NULL;
+
+		bool bClassChanged = false;
+		CUtlVector< item_definition_index_t > vecWantedExtras;
+
+		for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+		{
+			char szSlot[16];
+			V_snprintf( szSlot, sizeof( szSlot ), "%d", iSlot );
+			const int iWanted = pClassItems ? pClassItems->GetInt( szSlot, 0 ) : 0;
+			const bool bTouched = pClassTouched && pClassTouched->GetInt( szSlot, 0 ) != 0;
+
+			// Check the item really belongs in that slot for that class.
+			GameItemDefinition_t *pDef = NULL;
+			if ( iWanted > 0 && iWanted < INVALID_ITEM_DEF_INDEX && Mod_CanEquipDef( iWanted ) )
+			{
+				pDef = static_cast< GameItemDefinition_t * >( GetItemSchema()->GetItemDefinition( iWanted ) );
+				if ( pDef && ( !pDef->CanBeUsedByClass( iClass ) || !AreSlotsConsideredIdentical( pDef->GetEquipType(), pDef->GetLoadoutSlot( iClass ), iSlot ) ) )
+				{
+					pDef = NULL;
+				}
+			}
+
+			// Extra weapons ride on top of the loadout instead of taking the slot.
+			if ( pDef && Mod_GetExtraKeyFromDef( pDef ) > 0 )
+			{
+				if ( !vecWantedExtras.HasElement( (item_definition_index_t)iWanted ) )
+					vecWantedExtras.AddToTail( (item_definition_index_t)iWanted );
+				pDef = NULL;
+			}
+
+			ModEquip_t &current = m_ModEquips[iClass][iSlot];
+			bool bSlotChanged = false;
+			if ( pDef )
+			{
+				if ( current.m_iDef == iWanted && current.m_bFromInventory )
+					continue;	// already wearing it
+
+				ModEquip_t equip;
+				equip.Clear();
+				equip.m_iDef = (item_definition_index_t)iWanted;
+				equip.m_bFromInventory = true;
+				if ( Mod_SetItem( iClass, iSlot, equip ) )
+				{
+					Mod_PrecacheItemModels( pDef );
+					bSlotChanged = true;
+				}
+			}
+			else if ( current.m_iDef != INVALID_ITEM_DEF_INDEX && ( current.m_bFromInventory || bTouched ) )
+			{
+				current.Clear();
+				bSlotChanged = true;
+			}
+
+			if ( !bSlotChanged )
+				continue;
+
+			bClassChanged = true;
+
+			// Taunts work straight away, like the console command; everything else waits for a respawn / resupply.
+			if ( IsTauntSlot( iSlot ) && iClass == iCurrentClass )
+			{
+				CEconItemView *pTauntItem = GetLoadoutItem( iClass, iSlot );
+				m_EquippedLoadoutItemIndices[iSlot] = ( pTauntItem && pTauntItem->IsValid() ) ? pTauntItem->GetItemID() : LOADOUT_SLOT_USE_BASE_ITEM;
+			}
+		}
+
+		// Extra weapons: drop menu ones no longer equipped, then add new ones.
+		for ( int i = 0; i < MOD_MAX_EXTRA_WEAPONS; ++i )
+		{
+			ModEquip_t &extra = m_ModExtraEquips[iClass][i];
+			if ( extra.m_iDef != INVALID_ITEM_DEF_INDEX && extra.m_bFromInventory && !vecWantedExtras.HasElement( extra.m_iDef ) )
+			{
+				extra.Clear();
+				bClassChanged = true;
+			}
+		}
+		FOR_EACH_VEC( vecWantedExtras, w )
+		{
+			int iFree = -1;
+			bool bHave = false;
+			for ( int i = 0; i < MOD_MAX_EXTRA_WEAPONS && !bHave; ++i )
+			{
+				if ( m_ModExtraEquips[iClass][i].m_iDef == vecWantedExtras[w] )
+					bHave = true;
+				else if ( iFree < 0 && m_ModExtraEquips[iClass][i].m_iDef == INVALID_ITEM_DEF_INDEX )
+					iFree = i;
+			}
+			if ( bHave || iFree < 0 )
+				continue;
+
+			GameItemDefinition_t *pDef = static_cast< GameItemDefinition_t * >( GetItemSchema()->GetItemDefinition( vecWantedExtras[w] ) );
+			ModEquip_t extra;
+			extra.Clear();
+			extra.m_iDef = vecWantedExtras[w];
+			extra.m_nExtraKey = Mod_GetExtraKeyFromDef( pDef );
+			extra.m_bFromInventory = true;
+			if ( Mod_SetExtra( iClass, iFree, extra ) )
+			{
+				Mod_PrecacheItemModels( pDef );
+				bClassChanged = true;
+			}
+		}
+
+		if ( bClassChanged )
+		{
+			bAnyChange = true;
+			if ( iClass == iCurrentClass )
+				bCurrentClassChanged = true;
+		}
+	}
+
+	if ( bAnyChange )
+	{
+		Mod_SaveEquips();
+	}
+	if ( bCurrentClassChanged )
+	{
+		Mod_ApplyLoadoutChange( iCurrentClass );
+	}
+}
+
+static CUtlString Mod_ClassList( GameItemDefinition_t *pDef )
+{
+	CUtlString str;
+	int nClasses = 0;
+	for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS; ++iClass )
+	{
+		if ( pDef->CanBeUsedByClass( iClass ) )
+			++nClasses;
+	}
+	if ( nClasses == TF_LAST_NORMAL_CLASS - TF_FIRST_NORMAL_CLASS )
+		return CUtlString( "all classes" );
+
+	for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS; ++iClass )
+	{
+		if ( !pDef->CanBeUsedByClass( iClass ) )
+			continue;
+		if ( !str.IsEmpty() )
+			str += ", ";
+		str += g_aPlayerClassNames_NonLocalized[iClass];
+	}
+	return str;
+}
+
+static void Mod_PrintItemLine( CTFPlayer *pPlayer, int iDefIndex, GameItemDefinition_t *pDef )
+{
+	int iFirstClass = TF_CLASS_UNDEFINED;
+	for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS && iFirstClass == TF_CLASS_UNDEFINED; ++iClass )
+	{
+		if ( pDef->CanBeUsedByClass( iClass ) )
+			iFirstClass = iClass;
+	}
+	const char *pszSlot = ( iFirstClass != TF_CLASS_UNDEFINED ) ? Mod_SlotName( pDef->GetLoadoutSlot( iFirstClass ) ) : "-";
+	ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "  %5d  %-40s  %s, %s\n", iDefIndex, pDef->GetDefinitionName(), Mod_ClassList( pDef ).Get(), pszSlot ) );
+}
+
+static void Mod_PrintEquipHelp( CTFPlayer *pPlayer )
+{
+	ClientPrint( pPlayer, HUD_PRINTCONSOLE,
+		"Usage: mod_equip <item> [options]\n"
+		"  <item>  item index (e.g. 1071) or name (e.g. Gold Frying Pan). Find items with mod_find <words>.\n"
+		"  options: australium  festive  strange  unusual <effect id>  killstreak <1-3>\n"
+		"           sheen <1-7>  killstreaker <2002-2008>  quality <name>  style <number>\n"
+		"  Example: mod_equip Rocket Launcher australium killstreak 3 sheen 2 killstreaker 2004\n"
+		"  Taunts: mod_equip <taunt> puts it in a taunt slot (play with: taunt <slot>),\n"
+		"          mod_taunt <taunt> plays one right now.\n"
+		"  Extra weapons: mod_equip <weapon> extra <key 1-6> carries it on top of your loadout,\n"
+		"          on that number key (press the key again to cycle). Any number per key.\n" );
+}
+
+// Parses option words after the item name. Returns false (after printing why) on a bad option.
+static bool Mod_ParseEquipOptions( CTFPlayer *pPlayer, const CCommand &args, int iFirstArg, CTFPlayer::ModEquip_t &equip )
+{
+	for ( int i = iFirstArg; i < args.ArgC(); ++i )
+	{
+		const char *pszOpt = args[i];
+		const char *pszValue = ( i + 1 < args.ArgC() ) ? args[i + 1] : NULL;
+
+		if ( !V_stricmp( pszOpt, "australium" ) )		{ equip.m_bAustralium = true; continue; }
+		if ( !V_stricmp( pszOpt, "festive" ) )			{ equip.m_bFestive = true; continue; }
+		if ( !V_stricmp( pszOpt, "strange" ) )			{ equip.m_nQuality = AE_STRANGE; continue; }
+
+		int *pnTarget = NULL;
+		if ( !V_stricmp( pszOpt, "extra" ) )			pnTarget = &equip.m_nExtraKey;	// MOD: extra weapon on this key
+		else if ( !V_stricmp( pszOpt, "unusual" ) )		pnTarget = &equip.m_nUnusual;
+		else if ( !V_stricmp( pszOpt, "killstreak" ) )	pnTarget = &equip.m_nKillstreakTier;
+		else if ( !V_stricmp( pszOpt, "sheen" ) )		pnTarget = &equip.m_nSheen;
+		else if ( !V_stricmp( pszOpt, "killstreaker" ) )pnTarget = &equip.m_nKillstreaker;
+		else if ( !V_stricmp( pszOpt, "style" ) )		pnTarget = &equip.m_nStyle;
+
+		if ( pnTarget )
+		{
+			if ( !Mod_IsNumber( pszValue ) )
+			{
+				ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "\"%s\" needs a number after it.\n", pszOpt ) );
+				return false;
+			}
+			*pnTarget = V_atoi( pszValue );
+			++i;
+			continue;
+		}
+
+		if ( !V_stricmp( pszOpt, "quality" ) )
+		{
+			const int iQuality = pszValue ? Mod_QualityFromString( pszValue ) : -1;
+			if ( iQuality < 0 )
+			{
+				ClientPrint( pPlayer, HUD_PRINTCONSOLE, "quality must be one of: unique genuine vintage unusual community valve selfmade strange haunted collectors decorated\n" );
+				return false;
+			}
+			equip.m_nQuality = iQuality;
+			++i;
+			continue;
+		}
+
+		ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "Unknown option \"%s\".\n", pszOpt ) );
+		Mod_PrintEquipHelp( pPlayer );
+		return false;
+	}
+
+	equip.m_nKillstreakTier = clamp( equip.m_nKillstreakTier, 0, 3 );
+	if ( ( equip.m_nSheen || equip.m_nKillstreaker ) && equip.m_nKillstreakTier < 2 )
+	{
+		equip.m_nKillstreakTier = equip.m_nKillstreaker ? 3 : 2;	// sheens need Specialized, killstreakers need Professional
+	}
+	return true;
+}
+
+// Finds the item named by args[1..n] (longest match wins, so names don't need quotes).
+// Returns the index of the first option word, or -1 if no item matched.
+static int Mod_ParseItemFromArgs( const CCommand &args, item_definition_index_t &iDefOut )
+{
+	for ( int nLast = args.ArgC() - 1; nLast >= 1; --nLast )
+	{
+		CUtlString strName;
+		for ( int i = 1; i <= nLast; ++i )
+		{
+			if ( i > 1 )
+				strName += " ";
+			strName += args[i];
+		}
+
+		const item_definition_index_t iDef = Mod_FindItemDef( strName.Get() );
+		if ( iDef != INVALID_ITEM_DEF_INDEX )
+		{
+			iDefOut = iDef;
+			return nLast + 1;
+		}
+	}
+	return -1;
+}
+
+// Returns true if the command was one of ours.
+static bool Mod_HandleClientCommand( CTFPlayer *pPlayer, const CCommand &args )
+{
+	const char *pcmd = args[0];
+
+	if ( FStrEq( pcmd, "mod_items" ) )
+	{
+		ClientPrint( pPlayer, HUD_PRINTCONSOLE, "This mod's custom items (mod_equip <name or index>):\n" );
+		const CEconItemSchema::ItemDefinitionMap_t &mapDefs = GetItemSchema()->GetItemDefinitionMap();
+		FOR_EACH_MAP_FAST( mapDefs, i )
+		{
+			if ( Mod_IsModItemIndex( mapDefs.Key( i ) ) )
+			{
+				Mod_PrintItemLine( pPlayer, mapDefs.Key( i ), static_cast< GameItemDefinition_t * >( mapDefs[i] ) );
+			}
+		}
+		if ( tf_mod_allow_all_items.GetBool() )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, "Every TF2 item can be equipped too - search with mod_find <words>.\n" );
+		}
+		return true;
+	}
+
+	if ( FStrEq( pcmd, "mod_find" ) )
+	{
+		if ( args.ArgC() < 2 )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, "Usage: mod_find <words>   e.g. mod_find frying pan\n" );
+			return true;
+		}
+
+		CUtlString strWanted;
+		for ( int i = 1; i < args.ArgC(); ++i )
+		{
+			if ( i > 1 )
+				strWanted += " ";
+			strWanted += args[i];
+		}
+		const char *pszWanted = strWanted.Get();
+
+		char szWanted[256], szName[256];
+		Mod_NormalizeName( pszWanted, szWanted, sizeof( szWanted ) );
+
+		int nFound = 0, nShown = 0;
+		const CEconItemSchema::ItemDefinitionMap_t &mapDefs = GetItemSchema()->GetItemDefinitionMap();
+		FOR_EACH_MAP_FAST( mapDefs, i )
+		{
+			GameItemDefinition_t *pDef = static_cast< GameItemDefinition_t * >( mapDefs[i] );
+			Mod_NormalizeName( pDef->GetDefinitionName(), szName, sizeof( szName ) );
+			if ( !szWanted[0] || !V_strstr( szName, szWanted ) )
+				continue;
+
+			// Skip tools, crates and other things no class can use.
+			bool bUsable = false;
+			for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS && !bUsable; ++iClass )
+				bUsable = pDef->CanBeUsedByClass( iClass );
+			if ( !bUsable || !Mod_CanEquipDef( mapDefs.Key( i ) ) )
+				continue;
+
+			++nFound;
+			if ( nShown < MOD_FIND_MAX_RESULTS )
+			{
+				Mod_PrintItemLine( pPlayer, mapDefs.Key( i ), pDef );
+				++nShown;
+			}
+		}
+
+		if ( nFound > nShown )
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "...and %d more. Add more words to narrow it down.\n", nFound - nShown ) );
+		else if ( !nFound )
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "No items matching \"%s\".\n", pszWanted ) );
+		return true;
+	}
+
+	if ( FStrEq( pcmd, "mod_equip" ) )
+	{
+		if ( args.ArgC() < 2 )
+		{
+			Mod_PrintEquipHelp( pPlayer );
+			return true;
+		}
+
+		CTFPlayer::ModEquip_t equip;
+		equip.Clear();
+
+		const int iFirstOption = Mod_ParseItemFromArgs( args, equip.m_iDef );
+		if ( iFirstOption < 0 )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "No item called \"%s\". Try mod_find <words>.\n", args.ArgS() ) );
+			return true;
+		}
+
+		if ( !Mod_ParseEquipOptions( pPlayer, args, iFirstOption, equip ) )
+			return true;
+
+		if ( !pPlayer->Mod_EquipItem( equip ) )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "Couldn't equip \"%s\".\n", args.ArgS() ) );
+		}
+		return true;
+	}
+
+	if ( FStrEq( pcmd, "mod_taunt" ) )
+	{
+		if ( args.ArgC() < 2 )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, "Usage: mod_taunt <taunt name or index> [unusual <effect id>]   e.g. mod_taunt Kazotsky Kick\n" );
+			return true;
+		}
+
+		CTFPlayer::ModEquip_t equip;
+		equip.Clear();
+		const int iFirstOption = Mod_ParseItemFromArgs( args, equip.m_iDef );
+		if ( iFirstOption < 0 )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "No taunt called \"%s\". Try mod_find taunt.\n", args.ArgS() ) );
+			return true;
+		}
+		if ( Mod_ParseEquipOptions( pPlayer, args, iFirstOption, equip ) )
+		{
+			pPlayer->Mod_PlayTaunt( equip );
+		}
+		return true;
+	}
+
+	if ( FStrEq( pcmd, "mod_unequip" ) )
+	{
+		if ( args.ArgC() < 2 )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, "Usage: mod_unequip <name, index or all>\n" );
+			return true;
+		}
+
+		if ( !V_stricmp( args.ArgS(), "all" ) )
+		{
+			for ( int iClass = 0; iClass < TF_CLASS_COUNT_ALL; ++iClass )
+			{
+				for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+					pPlayer->Mod_UnequipItem( iClass, iSlot );
+				for ( int i = 0; i < CTFPlayer::MOD_MAX_EXTRA_WEAPONS; ++i )
+					pPlayer->Mod_UnequipExtra( iClass, i );
+			}
+
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, "Unequipped everything added with mod_equip.\n" );
+			return true;
+		}
+
+		item_definition_index_t iDefIndex = INVALID_ITEM_DEF_INDEX;
+		if ( Mod_ParseItemFromArgs( args, iDefIndex ) < 0 )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "No item called \"%s\".\n", args.ArgS() ) );
+			return true;
+		}
+
+		bool bFound = false;
+		for ( int iClass = 0; iClass < TF_CLASS_COUNT_ALL; ++iClass )
+		{
+			for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+			{
+				CEconItemView *pItem = pPlayer->Mod_GetItem( iClass, iSlot );
+				if ( pItem && pItem->GetItemDefIndex() == iDefIndex )
+				{
+					bFound |= pPlayer->Mod_UnequipItem( iClass, iSlot );
+				}
+			}
+			for ( int i = 0; i < CTFPlayer::MOD_MAX_EXTRA_WEAPONS; ++i )
+			{
+				CEconItemView *pItem = pPlayer->Mod_GetExtraItem( iClass, i );
+				if ( pItem && pItem->GetItemDefIndex() == iDefIndex )
+				{
+					bFound |= pPlayer->Mod_UnequipExtra( iClass, i );
+				}
+			}
+		}
+		ClientPrint( pPlayer, HUD_PRINTCONSOLE, bFound ? CFmtStr( "Unequipped \"%s\".\n", args.ArgS() ).Get() : CFmtStr( "\"%s\" isn't equipped.\n", args.ArgS() ).Get() );
+		return true;
+	}
+
+	return false;
+}
