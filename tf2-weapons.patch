+
+bool CTFProjectile_Rocket::IsValidHomingTarget( CBaseEntity *pTarget, bool bRequireCone )
+{
+	if ( !pTarget || pTarget == this )
+		return false;
+
+	if ( pTarget->GetTeamNumber() < FIRST_GAME_TEAM || pTarget->GetTeamNumber() == GetTeamNumber() )
+		return false;
+
+	if ( pTarget->IsPlayer() )
+	{
+		CTFPlayer *pPlayer = ToTFPlayer( pTarget );
+		if ( !pPlayer || !pPlayer->IsAlive() )
+			return false;
+
+		// Invisible spies and spies disguised as our team don't get locked.
+		if ( pPlayer->m_Shared.IsStealthed() )
+			return false;
+
+		if ( pPlayer->m_Shared.InCond( TF_COND_DISGUISED ) && pPlayer->m_Shared.GetDisguiseTeam() == GetTeamNumber() )
+			return false;
+	}
+	else
+	{
+		CBaseObject *pObject = dynamic_cast< CBaseObject * >( pTarget );
+		if ( !pObject || pObject->IsDying() || pObject->IsPlacing() || pObject->IsCarried() )
+			return false;
+	}
+
+	const Vector vecTarget = pTarget->WorldSpaceCenter();
+	Vector vecToTarget = vecTarget - GetAbsOrigin();
+	const float flDist = VectorNormalize( vecToTarget );
+	if ( flDist > tf_mod_homing_range.GetFloat() )
+		return false;
+
+	if ( bRequireCone )
+	{
+		Vector vecHeading = GetAbsVelocity();
+		VectorNormalize( vecHeading );
+		if ( DotProduct( vecHeading, vecToTarget ) < cosf( DEG2RAD( tf_mod_homing_lock_cone.GetFloat() ) ) )
+			return false;
+	}
+
+	trace_t tr;
+	UTIL_TraceLine( GetAbsOrigin(), vecTarget, MASK_SOLID_BRUSHONLY, this, COLLISION_GROUP_NONE, &tr );
+	return tr.fraction >= 1.0f || tr.m_pEnt == pTarget;
+}
+
+CBaseEntity *CTFProjectile_Rocket::FindHomingTarget( void )
+{
+	Vector vecHeading = GetAbsVelocity();
+	VectorNormalize( vecHeading );
+
+	CBaseEntity *pBest = NULL;
+	float flBestDot = -1.f;
+
+	CUtlVector< CBaseEntity * > vecCandidates;
+	for ( int i = 1; i <= gpGlobals->maxClients; ++i )
+	{
+		CBaseEntity *pPlayer = UTIL_PlayerByIndex( i );
+		if ( pPlayer )
+		{
+			vecCandidates.AddToTail( pPlayer );
+		}
+	}
+	for ( int i = 0; i < IBaseObjectAutoList::AutoList().Count(); ++i )
+	{
+		vecCandidates.AddToTail( static_cast< CBaseObject * >( IBaseObjectAutoList::AutoList()[i] ) );
+	}
+
+	FOR_EACH_VEC( vecCandidates, i )
+	{
+		CBaseEntity *pCandidate = vecCandidates[i];
+		if ( !IsValidHomingTarget( pCandidate, true ) )
+			continue;
+
+		// Prefer whatever is nearest to the rocket's line of flight.
+		Vector vecToTarget = pCandidate->WorldSpaceCenter() - GetAbsOrigin();
+		VectorNormalize( vecToTarget );
+		const float flDot = DotProduct( vecHeading, vecToTarget );
+		if ( flDot > flBestDot )
+		{
+			flBestDot = flDot;
+			pBest = pCandidate;
+		}
+	}
+
+	return pBest;
+}
+
+void CTFProjectile_Rocket::HomingThink( void )
+{
+	SetNextThink( gpGlobals->curtime );
+
+	const float flNow = gpGlobals->curtime;
+
+	// Keep (or drop) the current lock.
+	CBaseEntity *pTarget = m_hHomingTarget.Get();
+	bool bCanSee = false;
+	if ( pTarget )
+	{
+		if ( IsValidHomingTarget( pTarget, false ) )
+		{
+			bCanSee = true;
+			m_flLastSawTargetTime = flNow;
+		}
+		else if ( !pTarget->IsAlive() || pTarget->GetTeamNumber() == GetTeamNumber() || flNow - m_flLastSawTargetTime > tf_mod_homing_lost_time.GetFloat() )
+		{
+			m_hHomingTarget = NULL;
+			pTarget = NULL;
+		}
+	}
+
+	// No lock: look for a new one a few times a second.
+	if ( !pTarget && ( gpGlobals->tickcount % 3 ) == 0 )
+	{
+		pTarget = FindHomingTarget();
+		if ( pTarget )
+		{
+			m_hHomingTarget = pTarget;
+			m_flLastSawTargetTime = flNow;
+			bCanSee = true;
+		}
+	}
+
+	if ( !pTarget || !bCanSee || flNow < m_flHomingStartTime )
+		return;
+
+	// Turn toward the target at a capped rate, keeping our speed.
+	Vector vecVelocity = GetAbsVelocity();
+	const float flSpeed = vecVelocity.Length();
+	if ( flSpeed < 1.f )
+		return;
+
+	Vector vecDir = vecVelocity / flSpeed;
+	Vector vecToTarget = pTarget->WorldSpaceCenter() - GetAbsOrigin();
+	VectorNormalize( vecToTarget );
+
+	const float flAngle = acosf( clamp( DotProduct( vecDir, vecToTarget ), -1.f, 1.f ) );
+	const float flMaxTurn = DEG2RAD( tf_mod_homing_turn_rate.GetFloat() * m_flHomingPower ) * gpGlobals->interval_per_tick;
+
+	Vector vecNewDir;
+	const float flSin = sinf( flAngle );
+	if ( flAngle <= flMaxTurn || flSin < 0.001f )
+	{
+		vecNewDir = ( flAngle <= flMaxTurn ) ? vecToTarget : vecDir;
+	}
+	else
+	{
+		// Spherical interpolation by the allowed fraction of the turn.
+		const float t = flMaxTurn / flAngle;
+		vecNewDir = vecDir * ( sinf( ( 1.f - t ) * flAngle ) / flSin ) + vecToTarget * ( sinf( t * flAngle ) / flSin );
+		VectorNormalize( vecNewDir );
+	}
+
+	SetAbsVelocity( vecNewDir * flSpeed );
+
+	QAngle angNew;
+	VectorAngles( vecNewDir, angNew );
+	SetAbsAngles( angNew );
 }
 
