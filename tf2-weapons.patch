+//=============================================================================
+// MOD: dual wield, third person. A client-side copy of the weapon's world model
+// that every client draws in the owner's left hand. Each frame it takes the
+// right-hand gun's bones, mirrors them across the player's body, and moves them
+// from the right hand to the left hand, so the second gun is held the same way.
+//=============================================================================
+class C_ModDualWorldModel : public C_BaseAnimating
+{
+	DECLARE_CLASS( C_ModDualWorldModel, C_BaseAnimating );
+public:
+	void SetWeapon( C_TFWeaponBase *pWeapon ) { m_hWeapon = pWeapon; }
+	bool ShouldShow( void );
+
+	virtual int DrawModel( int flags ) OVERRIDE;
+	virtual int InternalDrawModel( int flags ) OVERRIDE;
+	virtual bool OnInternalDrawModel( ClientModelRenderInfo_t *pInfo ) OVERRIDE;
+	virtual void BuildTransformations( CStudioHdr *pStudioHdr, Vector *pos, Quaternion q[], const matrix3x4_t& cameraTransform, int boneMask, CBoneBitList &boneComputed ) OVERRIDE;
+	virtual void GetRenderBounds( Vector& theMins, Vector& theMaxs ) OVERRIDE;
+	virtual ShadowType_t ShadowCastType() OVERRIDE { return SHADOWS_NONE; }
+	virtual void GetColorModulation( float *color ) OVERRIDE;
+
+private:
+	CHandle<C_TFWeaponBase> m_hWeapon;
+};
+
+bool C_ModDualWorldModel::ShouldShow( void )
+{
+	C_TFWeaponBase *pWeapon = m_hWeapon.Get();
+	if ( !pWeapon || pWeapon->IsDormant() )
+		return false;
+
+	C_TFPlayer *pOwner = ToTFPlayer( pWeapon->GetOwner() );
+	if ( !pOwner || pOwner->IsDormant() || !pOwner->IsAlive() || !pOwner->ShouldDrawThisPlayer() )
+		return false;
+
+	if ( pOwner->GetActiveWeapon() != pWeapon || pWeapon->IsEffectActive( EF_NODRAW ) || !pWeapon->ShouldDraw() )
+		return false;
+
+	// Only while the right-hand gun is showing the same world model as us.
+	if ( pWeapon->GetModelIndex() != GetModelIndex() )
+		return false;
+
+	if ( pOwner->GetPercentInvisible() > 0.f )
+		return false;
+
+	return true;
+}
+
+void C_ModDualWorldModel::GetColorModulation( float *color )
+{
+	BaseClass::GetColorModulation( color );
+
+	Vector vecTint;
+	if ( m_hWeapon.Get() && m_hWeapon->Mod_GetTint( vecTint ) )
+	{
+		color[0] *= vecTint.x;
+		color[1] *= vecTint.y;
+		color[2] *= vecTint.z;
+	}
+}
+
+int C_ModDualWorldModel::DrawModel( int flags )
+{
+	if ( !ShouldShow() )
+		return 0;
+
+	m_nSkin = m_hWeapon->GetSkin();
+	return BaseClass::DrawModel( flags );
+}
+
+int C_ModDualWorldModel::InternalDrawModel( int flags )
+{
+	// The bones are a mirror image, so the faces wind the other way.
+	CMatRenderContextPtr pRenderContext( materials );
+	pRenderContext->CullMode( MATERIAL_CULLMODE_CW );
+	int ret = BaseClass::InternalDrawModel( flags );
+	pRenderContext->CullMode( MATERIAL_CULLMODE_CCW );
+	return ret;
+}
+
+bool C_ModDualWorldModel::OnInternalDrawModel( ClientModelRenderInfo_t *pInfo )
+{
+	// Light it like the player holding it.
+	C_BaseEntity *pOwner = m_hWeapon.Get() ? m_hWeapon->GetOwner() : NULL;
+	if ( pOwner && pInfo )
+	{
+		pInfo->pLightingOrigin = &( pOwner->WorldSpaceCenter() );
+	}
+	return BaseClass::OnInternalDrawModel( pInfo );
+}
+
+void C_ModDualWorldModel::GetRenderBounds( Vector& theMins, Vector& theMaxs )
+{
+	// We sit at the player's feet but draw at their hand.
+	theMins.Init( -64.f, -64.f, -16.f );
+	theMaxs.Init( 64.f, 64.f, 112.f );
+}
+
+void C_ModDualWorldModel::BuildTransformations( CStudioHdr *pStudioHdr, Vector *pos, Quaternion q[], const matrix3x4_t& cameraTransform, int boneMask, CBoneBitList &boneComputed )
+{
+	BaseClass::BuildTransformations( pStudioHdr, pos, q, cameraTransform, boneMask, boneComputed );
+
+	C_TFWeaponBase *pWeapon = m_hWeapon.Get();
+	C_TFPlayer *pOwner = pWeapon ? ToTFPlayer( pWeapon->GetOwner() ) : NULL;
+	if ( !pOwner || !pStudioHdr || pWeapon->GetModelIndex() != GetModelIndex() )
+		return;
+
+	CStudioHdr *pWeaponHdr = pWeapon->GetModelPtr();
+	if ( !pWeaponHdr || pWeaponHdr->numbones() != pStudioHdr->numbones() )
+		return;
+
+	int iHandR = pOwner->LookupBone( "bip_hand_R" );
+	int iHandL = pOwner->LookupBone( "bip_hand_L" );
+	if ( iHandR < 0 || iHandL < 0 )
+		return;
+
+	static matrix3x4_t s_OwnerBones[MAXSTUDIOBONES];
+	static matrix3x4_t s_WeaponBones[MAXSTUDIOBONES];
+	if ( !pOwner->SetupBones( s_OwnerBones, MAXSTUDIOBONES, BONE_USED_BY_ANYTHING, gpGlobals->curtime ) )
+		return;
+	if ( !pWeapon->SetupBones( s_WeaponBones, MAXSTUDIOBONES, BONE_USED_BY_ANYTHING, gpGlobals->curtime ) )
+		return;
+
+	// Mirror across the player's body: reflect along their right/left axis.
+	QAngle angYaw( 0.f, pOwner->GetRenderAngles()[YAW], 0.f );
+	Vector n;
+	AngleVectors( angYaw, NULL, &n, NULL );
+
+	matrix3x4_t matReflect;
+	for ( int r = 0; r < 3; ++r )
+	{
+		for ( int c = 0; c < 3; ++c )
+		{
+			matReflect[r][c] = ( r == c ? 1.f : 0.f ) - 2.f * n[r] * n[c];
+		}
+		matReflect[r][3] = 0.f;
+	}
+
+	Vector vecHandR, vecHandL;
+	MatrixPosition( s_OwnerBones[iHandR], vecHandR );
+	MatrixPosition( s_OwnerBones[iHandL], vecHandL );
+
+	for ( int i = 0; i < pStudioHdr->numbones(); ++i )
+	{
+		matrix3x4_t matBone;
+		ConcatTransforms( matReflect, s_WeaponBones[i], matBone );
+
+		// Same offset from the left hand as the right gun has from the right hand (mirrored).
+		Vector vecPos, vecMirrored;
+		MatrixPosition( s_WeaponBones[i], vecPos );
+		VectorRotate( vecPos - vecHandR, matReflect, vecMirrored );
+		MatrixSetColumn( vecMirrored + vecHandL, 3, matBone );
+
+		MatrixCopy( matBone, GetBoneForWrite( i ) );
+	}
+}
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: "mod weapon tint" - each custom weapon gets its own colour.
+//-----------------------------------------------------------------------------
+bool CTFWeaponBase::Mod_GetTint( Vector &vecTint )
+{
+	if ( m_nModTint < 0 )
+		return false;
+
+	vecTint.Init( ( ( m_nModTint >> 16 ) & 0xFF ) / 255.f, ( ( m_nModTint >> 8 ) & 0xFF ) / 255.f, ( m_nModTint & 0xFF ) / 255.f );
+	return true;
+}
+
+void CTFWeaponBase::GetColorModulation( float *color )
+{
+	BaseClass::GetColorModulation( color );
+
+	Vector vecTint;
+	if ( Mod_GetTint( vecTint ) )
+	{
+		color[0] *= vecTint.x;
+		color[1] *= vecTint.y;
+		color[2] *= vecTint.z;
+	}
+}
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: dual wield - create or remove the third-person left-hand gun.
+//-----------------------------------------------------------------------------
+void CTFWeaponBase::Mod_UpdateDualWorldModel( void )
+{
+	C_BaseEntity *pOwner = GetOwner();
+	bool bWant = pOwner && !m_bDisguiseWeapon && Mod_IsDualWield() && GetWorldModelIndex() > 0;
+
+	if ( !bWant )
+	{
+		if ( m_hModDualWorldModel )
+		{
+			m_hModDualWorldModel->Release();
+			m_hModDualWorldModel = NULL;
+		}
+		return;
+	}
+
+	if ( !m_hModDualWorldModel )
+	{
+		const model_t *pModel = modelinfo->GetModel( GetWorldModelIndex() );
+		const char *pszModel = pModel ? modelinfo->GetModelName( pModel ) : NULL;
+		if ( !pszModel || !pszModel[0] )
+			return;
+
+		C_ModDualWorldModel *pEnt = new C_ModDualWorldModel;
+		if ( !pEnt )
+			return;
+
+		pEnt->SetWeapon( this );
+		pEnt->AddEffects( EF_NORECEIVESHADOW | EF_NOSHADOW );
+		if ( !pEnt->InitializeAsClientEntity( pszModel, RENDER_GROUP_OPAQUE_ENTITY ) )
+		{
+			pEnt->Release();
+			return;
+		}
+
+		pEnt->AddSolidFlags( FSOLID_NOT_SOLID );
+		pEnt->SetSequence( 0 );
+		pEnt->SetCycle( 0 );
+		m_hModDualWorldModel = pEnt;
+	}
+
+	if ( m_hModDualWorldModel->GetMoveParent() != pOwner )
+	{
+		m_hModDualWorldModel->SetParent( pOwner );
+		m_hModDualWorldModel->SetLocalOrigin( vec3_origin );
+		m_hModDualWorldModel->SetLocalAngles( vec3_angle );
+		m_hModDualWorldModel->UpdateVisibility();
+	}
+}
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: dual wield. The first-person weapon model is a separate entity
+// bone-merged onto the viewmodel's hands. Keep a second copy on viewmodel 1.
+//-----------------------------------------------------------------------------
+void CTFWeaponBase::Mod_UpdateDualAttachment( void )
+{
+	C_BaseAnimating *pMain = m_hViewmodelAttachment.Get();
+	C_BasePlayer *pOwner = ToBasePlayer( GetOwnerEntity() );
+	C_BaseViewModel *pVM1 = pOwner ? pOwner->GetViewModel( 1, false ) : NULL;
+
+	if ( pMain && pMain->GetModel() && pVM1 && !m_bDisguiseWeapon && Mod_IsDualWield() )
+	{
+		if ( !m_hModDualAttachment )
+		{
+			C_ViewmodelAttachmentModel *pEnt = new class C_ViewmodelAttachmentModel;
+			if ( !pEnt )
+				return;
+
+			pEnt->SetOuter( this );
+			pEnt->Mod_SetMirrored( true );
+			if ( pEnt->InitializeAsClientEntity( modelinfo->GetModelName( pMain->GetModel() ), RENDER_GROUP_VIEW_MODEL_OPAQUE ) == false )
+				return;
+
+			m_hModDualAttachment = pEnt;
+			m_hModDualAttachment->SetParent( pVM1 );
+			m_hModDualAttachment->SetLocalOrigin( vec3_origin );
+			m_hModDualAttachment->UpdatePartitionListEntry();
+			m_hModDualAttachment->CollisionProp()->UpdatePartition();
+			m_hModDualAttachment->UpdateVisibility();
+		}
+		else if ( m_hModDualAttachment->GetMoveParent() != pVM1 )
+		{
+			m_hModDualAttachment->SetParent( pVM1 );
+			m_hModDualAttachment->SetLocalOrigin( vec3_origin );
+		}
+
+		m_hModDualAttachment->m_nSkin = pMain->m_nSkin;
+		return;
+	}
+
+	if ( m_hModDualAttachment )
+	{
+		m_hModDualAttachment->Release();
+		m_hModDualAttachment = NULL;
+	}
+}
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: dual wield. When viewmodel 1 (the left hand) draws, draw the
+// left-hand copy of the weapon on it instead of the right-hand one.
+//-----------------------------------------------------------------------------
+int CTFWeaponBase::DrawOverriddenViewmodel( C_BaseViewModel *pViewmodel, int flags )
+{
+	if ( pViewmodel && pViewmodel->ViewModelIndex() == 1 && m_nViewModelIndex == 0 )
+	{
+		if ( !m_hModDualAttachment || !m_hViewmodelAttachment )
