+//=============================================================================
+//
+// MOD: Console-equipped items
+//
+// Nothing here touches the Steam inventory: these are local copies that only
+// exist in this mod, for as long as the server runs.
+//
+//    mod_items                     list this mod's custom items
+//    mod_find <words>              search every TF2 item by name
+//    mod_equip <item> [options]    item = index (1071) or name ("Gold Frying Pan")
+//        options: australium  festive  strange  unusual <effect id>
+//                 killstreak <1-3>  sheen <1-7>  killstreaker <2002-2008>
+//                 quality <name or number>  style <number>
+//    mod_unequip <item | all>
+//
+//=============================================================================
+ConVar tf_mod_allow_all_items( "tf_mod_allow_all_items", "1", FCVAR_NOTIFY, "1 = players can mod_equip any item in TF2's item list. 0 = only this mod's custom items." );
+
+#define MOD_ITEM_INDEX_MIN		38000
+#define MOD_ITEM_INDEX_MAX		39999
+#define MOD_FAKE_ITEMID_BASE	( 1ull << 62 )
+#define MOD_FIND_MAX_RESULTS	60
+
+static bool Mod_IsModItemIndex( int iDefIndex )
+{
+	return iDefIndex >= MOD_ITEM_INDEX_MIN && iDefIndex <= MOD_ITEM_INDEX_MAX;
+}
+
+static bool Mod_CanEquipDef( int iDefIndex )
+{
+	return Mod_IsModItemIndex( iDefIndex ) || tf_mod_allow_all_items.GetBool();
+}
+
+static const char *Mod_SlotName( int iSlot )
+{
+	switch ( iSlot )
+	{
+	case LOADOUT_POSITION_PRIMARY:		return "primary";
+	case LOADOUT_POSITION_SECONDARY:	return "secondary";
+	case LOADOUT_POSITION_MELEE:		return "melee";
+	case LOADOUT_POSITION_BUILDING:		return "building";
+	case LOADOUT_POSITION_PDA:			return "pda";
+	case LOADOUT_POSITION_PDA2:			return "pda2";
+	case LOADOUT_POSITION_HEAD:
+	case LOADOUT_POSITION_MISC:
+	case LOADOUT_POSITION_MISC2:		return "cosmetic";
+	case LOADOUT_POSITION_ACTION:		return "action";
+	default:							return IsTauntSlot( iSlot ) ? "taunt" : "other";
+	}
+}
+
+static bool Mod_IsNumber( const char *psz )
+{
+	if ( !psz || !*psz )
+		return false;
+	for ( ; *psz; ++psz )
+	{
+		if ( *psz < '0' || *psz > '9' )
+			return false;
+	}
+	return true;
+}
+
+// Lower-cases a name and drops "The ", "Upgradeable ", "TF_WEAPON_" and anything that isn't a
+// letter or digit, so "Rocket Launcher", "rocketlauncher" and "TF_WEAPON_ROCKETLAUNCHER" all match.
+static void Mod_NormalizeName( const char *pszIn, char *pszOut, int nOutSize )
+{
+	const char *p = pszIn ? pszIn : "";
+	for ( bool bStripped = true; bStripped; )
+	{
+		bStripped = false;
+		static const char *s_Prefixes[] = { "the ", "upgradeable ", "tf_weapon_", "taunt: " };
+		for ( int i = 0; i < ARRAYSIZE( s_Prefixes ); ++i )
+		{
+			const int nLen = V_strlen( s_Prefixes[i] );
+			if ( !V_strnicmp( p, s_Prefixes[i], nLen ) )
+			{
+				p += nLen;
+				bStripped = true;
+			}
+		}
+	}
+
+	int n = 0;
+	for ( ; *p && n < nOutSize - 1; ++p )
+	{
+		const char c = *p;
+		if ( ( c >= '0' && c <= '9' ) || ( c >= 'a' && c <= 'z' ) )
+			pszOut[n++] = c;
+		else if ( c >= 'A' && c <= 'Z' )
+			pszOut[n++] = c - 'A' + 'a';
+	}
+	pszOut[n] = 0;
+}
+
+// Accepts a definition index or an item name ("Gold Frying Pan", "The Sandman", "Rocket Launcher").
+// An exact name wins; otherwise a loose match, preferring the "Upgradeable" copy of stock weapons
+// because that's the one with Strange/Australium styles.
+static item_definition_index_t Mod_FindItemDef( const char *pszNameOrIndex )
+{
+	if ( !pszNameOrIndex || !*pszNameOrIndex )
+		return INVALID_ITEM_DEF_INDEX;
+
+	if ( Mod_IsNumber( pszNameOrIndex ) )
+	{
+		const int iIndex = V_atoi( pszNameOrIndex );
+		return GetItemSchema()->GetItemDefinition( iIndex ) ? (item_definition_index_t)iIndex : INVALID_ITEM_DEF_INDEX;
+	}
+
+	const CEconItemSchema::ItemDefinitionMap_t &mapDefs = GetItemSchema()->GetItemDefinitionMap();
+	FOR_EACH_MAP_FAST( mapDefs, i )
+	{
+		if ( !V_stricmp( mapDefs[i]->GetDefinitionName(), pszNameOrIndex ) )
+			return mapDefs.Key( i );
+	}
+
+	char szWanted[256], szName[256];
+	Mod_NormalizeName( pszNameOrIndex, szWanted, sizeof( szWanted ) );
+	if ( !szWanted[0] )
+		return INVALID_ITEM_DEF_INDEX;
+
+	// Common nicknames.
+	static const struct { const char *pszAlias; const char *pszName; } s_Aliases[] =
+	{
+		{ "goldenfryingpan",	"Gold Frying Pan" },
+		{ "goldenpan",			"Gold Frying Pan" },
+		{ "goldpan",			"Gold Frying Pan" },
+		{ "australiumfryingpan","Gold Frying Pan" },
+	};
+	for ( int i = 0; i < ARRAYSIZE( s_Aliases ); ++i )
+	{
+		if ( !V_strcmp( szWanted, s_Aliases[i].pszAlias ) )
+			return Mod_FindItemDef( s_Aliases[i].pszName );
+	}
+
+	item_definition_index_t iMatch = INVALID_ITEM_DEF_INDEX;
+	FOR_EACH_MAP_FAST( mapDefs, i )
+	{
+		Mod_NormalizeName( mapDefs[i]->GetDefinitionName(), szName, sizeof( szName ) );
+		if ( V_strcmp( szName, szWanted ) )
+			continue;
+
+		if ( !V_strnicmp( mapDefs[i]->GetDefinitionName(), "Upgradeable ", 12 ) )
+			return mapDefs.Key( i );
+		if ( iMatch == INVALID_ITEM_DEF_INDEX )
+			iMatch = mapDefs.Key( i );
+	}
+
+	return iMatch;
+}
+
+static int Mod_QualityFromString( const char *psz )
+{
+	if ( Mod_IsNumber( psz ) )
+		return V_atoi( psz );
+
+	static const struct { const char *pszName; int iQuality; } s_Qualities[] =
+	{
+		{ "normal",		AE_UNIQUE },	// normal quality items are treated as unique here
+		{ "unique",		AE_UNIQUE },
+		{ "genuine",	AE_RARITY1 },
+		{ "vintage",	AE_VINTAGE },
+		{ "unusual",	AE_UNUSUAL },
+		{ "community",	AE_COMMUNITY },
+		{ "valve",		AE_DEVELOPER },
+		{ "selfmade",	AE_SELFMADE },
+		{ "strange",	AE_STRANGE },
+		{ "haunted",	AE_HAUNTED },
+		{ "collectors",	AE_COLLECTORS },
+		{ "decorated",	AE_PAINTKITWEAPON },
+	};
+	for ( int i = 0; i < ARRAYSIZE( s_Qualities ); ++i )
+	{
+		if ( !V_stricmp( psz, s_Qualities[i].pszName ) )
+			return s_Qualities[i].iQuality;
+	}
+	return -1;
+}
+
+static void Mod_SetRuntimeAttr( CEconItemView &item, const char *pszAttrName, float flValue )
+{
+	const CEconItemAttributeDefinition *pAttrDef = GetItemSchema()->GetAttributeDefinitionByName( pszAttrName );
+	if ( pAttrDef )
+	{
+		item.GetAttributeList()->SetRuntimeAttributeValue( pAttrDef, flValue );
+	}
+}
