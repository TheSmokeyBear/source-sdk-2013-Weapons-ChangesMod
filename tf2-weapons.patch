+void CTFProjectile_Rocket::StartHoming( float flPower )
+{
+	m_flHomingPower = flPower;
+	m_flHomingStartTime = gpGlobals->curtime + tf_mod_homing_arm_time.GetFloat();
+
+	// Lock onto whatever is closest to the crosshair right as we fire.
