 bool CTFWeaponBase::SendWeaponAnim( int iActivity )
+{
+	// MOD: dual wield. The right gun is viewmodel 0 (the normal one); the left gun is
+	// viewmodel 1, drawn mirrored. Fire animations alternate between the two guns,
+	// every other animation (draw, reload, idle, inspect) plays on both.
+	CTFPlayer *pDualOwner = GetTFPlayerOwner();
+	if ( pDualOwner && m_nViewModelIndex == 0 && pDualOwner->GetViewModel( 1, false ) && Mod_IsDualWield() )
+	{
+		if ( iActivity == ACT_VM_PRIMARYATTACK )
+		{
+			m_bModDualLastLeft = !m_bModDualLastLeft;
+			if ( !m_bModDualLastLeft )
+				return Mod_SendWeaponAnimInternal( iActivity );
+
+			// Left gun: play the shot on viewmodel 1 and leave the right gun alone.
+			m_nViewModelIndex = 1;
+			bool bLeft = Mod_SendWeaponAnimInternal( iActivity );
+			m_nViewModelIndex = 0;
+			return bLeft;
+		}
+
+		CBaseViewModel *pVM0 = pDualOwner->GetViewModel( 0, false );
+		int nOldSequence = pVM0 ? pVM0->GetSequence() : -1;
+		float flOldCycle = pVM0 ? pVM0->GetCycle() : -1.f;
+
+		bool bRet = Mod_SendWeaponAnimInternal( iActivity );
+
+		// Copy only if the right gun actually started a new animation (inspect can swallow idles).
+		if ( pVM0 && ( pVM0->GetSequence() != nOldSequence || pVM0->GetCycle() != flOldCycle || pVM0->GetCycle() == 0.f ) )
+		{
+			Mod_SyncDualViewModel();
+		}
+		return bRet;
+	}
+
+	return Mod_SendWeaponAnimInternal( iActivity );
+}
