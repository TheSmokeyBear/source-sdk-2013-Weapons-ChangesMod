+#ifdef GAME_DLL
+//-----------------------------------------------------------------------------
+// MOD: "mod medigun portal to patient" (value = how much UberCharge it costs, 0.25 = 25%).
+// Press reload while healing someone to step out of a portal right next to them.
+//-----------------------------------------------------------------------------
+ConVar tf_mod_medigun_portal_cooldown( "tf_mod_medigun_portal_cooldown", "3", FCVAR_NOTIFY, "Seconds between portal jumps for mediguns with \"mod medigun portal to patient\"." );
+
+static bool Mod_FindPortalSpot( CTFPlayer *pMedic, CTFPlayer *pPatient, Vector &vecOut )
+{
+	const Vector vecMins = pMedic->GetPlayerMins();
+	const Vector vecMaxs = pMedic->GetPlayerMaxs();
+	const Vector vecPatient = pPatient->GetAbsOrigin() + Vector( 0, 0, 4 );
+
+	QAngle angFlat( 0.f, pPatient->EyeAngles().y, 0.f );
+	Vector vecForward, vecRight;
+	AngleVectors( angFlat, &vecForward, &vecRight, NULL );
+
+	const float flGap = ( vecMaxs.x - vecMins.x ) + 8.f;	// a body width apart
+	const Vector vecOffsets[] =
+	{
+		-vecForward * flGap,							// behind them
+		-vecRight * flGap,								// left
+		vecRight * flGap,								// right
+		( -vecForward - vecRight ) * ( flGap * 0.75f ),
+		( -vecForward + vecRight ) * ( flGap * 0.75f ),
+		vecForward * flGap,								// in front
+		Vector( 0, 0, ( vecMaxs.z - vecMins.z ) + 4.f ),	// on their head, as a last resort
+	};
+
+	CTraceFilterSkipTwoEntities filter( pMedic, pPatient, COLLISION_GROUP_PLAYER_MOVEMENT );
+	for ( int i = 0; i < ARRAYSIZE( vecOffsets ); ++i )
+	{
+		// Must be reachable from the patient (no portalling through walls) ...
+		const Vector vecTry = vecPatient + vecOffsets[i];
+		trace_t tr;
+		UTIL_TraceHull( vecPatient, vecTry, vecMins, vecMaxs, MASK_PLAYERSOLID, &filter, &tr );
+		if ( tr.startsolid || tr.fraction < 1.f )
+			continue;
+
+		// ... and have room to stand.
+		UTIL_TraceHull( vecTry, vecTry, vecMins, vecMaxs, MASK_PLAYERSOLID, &filter, &tr );
+		if ( tr.startsolid || tr.allsolid )
+			continue;
+
+		vecOut = vecTry;
+		return true;
+	}
+
+	return false;
+}
+
+void CWeaponMedigun::Mod_TryPortalToPatient( void )
+{
+	float flCost = 0.f;
+	CALL_ATTRIB_HOOK_FLOAT( flCost, mod_medigun_portal_to_patient );
+	if ( flCost <= 0.f )
+		return;
+
+	CTFPlayer *pOwner = ToTFPlayer( GetOwner() );
+	if ( !pOwner || !pOwner->IsAlive() )
+		return;
+
+	if ( gpGlobals->curtime < m_flModNextPortalTime )
+		return;
+
+	const char *pszProblem = NULL;
+	char szCost[64];
+	V_snprintf( szCost, sizeof( szCost ), "Portal needs %d%% UberCharge.", RoundFloatToInt( flCost * 100.f ) );
+	CTFPlayer *pPatient = ToTFPlayer( m_hHealingTarget );
+	Vector vecDest;
+	if ( !pPatient || !pPatient->IsAlive() )
+		pszProblem = "Heal a teammate first, then press Reload to portal to them.";
+	else if ( IsReleasingCharge() )
+		pszProblem = "Can't portal during an UberCharge.";
+	else if ( m_flChargeLevel < flCost )
+		pszProblem = szCost;
+	else if ( pOwner->HasTheFlag() )
+		pszProblem = "Can't portal while carrying the intelligence.";
+	else if ( pOwner->GetAbsOrigin().DistToSqr( pPatient->GetAbsOrigin() ) < Square( 150.f ) )
+		pszProblem = "You're already next to your patient.";
+	else if ( !Mod_FindPortalSpot( pOwner, pPatient, vecDest ) )
+		pszProblem = "No room to portal next to your patient.";
+
+	if ( pszProblem )
+	{
+		ClientPrint( pOwner, HUD_PRINTCENTER, pszProblem );
+		pOwner->EmitSound( "Player.DenyWeaponSelection" );
+		m_flModNextPortalTime = gpGlobals->curtime + 0.5f;	// don't spam
+		return;
+	}
+
+	const char *pszParticle = ( pOwner->GetTeamNumber() == TF_TEAM_BLUE ) ? "teleported_blue" : "teleported_red";
+
+	// Portal out ...
+	DispatchParticleEffect( pszParticle, pOwner->GetAbsOrigin(), vec3_angle );
+	pOwner->EmitSound( "Building_Teleporter.Send" );
+
+	// ... and in, keeping where you're looking.
+	pOwner->Teleport( &vecDest, NULL, &vec3_origin );
+	DispatchParticleEffect( pszParticle, vecDest, vec3_angle );
+	pOwner->EmitSound( "Building_Teleporter.Receive" );
+	pOwner->TeleportEffect();	// the usual teleporter sparkle trail
+
+	m_flChargeLevel = Max( 0.f, m_flChargeLevel - flCost );
+	m_flModNextPortalTime = gpGlobals->curtime + tf_mod_medigun_portal_cooldown.GetFloat();
+}
+#endif // GAME_DLL
