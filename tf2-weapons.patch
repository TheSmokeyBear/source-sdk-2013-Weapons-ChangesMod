+//-----------------------------------------------------------------------------
+// Purpose: MOD: "mod auto reflect rockets". When an enemy rocket is about to hit
+// us and an airblast is ready, airblast on our own and send it where we're
+// aiming. Runs on the server and in client prediction, so the airblast shows
+// on the player's own screen too; the server decides what actually happens.
+//-----------------------------------------------------------------------------
+ConVar tf_mod_autoreflect_range( "tf_mod_autoreflect_range", "220", FCVAR_REPLICATED | FCVAR_NOTIFY, "Auto-reflect flamethrower: how close (units) an incoming rocket gets before it's airblasted." );
+
+static bool Mod_IsReflectableRocket( CBaseEntity *pEntity )
+{
+	return dynamic_cast< CTFProjectile_Rocket * >( pEntity ) != NULL			// rockets, incl. Direct Hit, Air Strike, sentry rockets
+		|| dynamic_cast< CTFProjectile_EnergyBall * >( pEntity ) != NULL;	// Cow Mangler
+}
+
+bool CTFFlameThrower::Mod_AutoReflectRockets( void )
+{
+	int iAutoReflect = 0;
+	CALL_ATTRIB_HOOK_INT( iAutoReflect, mod_auto_reflect_rockets );
+	if ( !iAutoReflect )
+		return false;
+
+	CTFPlayer *pOwner = GetTFPlayerOwner();
+	if ( !pOwner || !pOwner->IsAlive() || pOwner->GetActiveWeapon() != this )
+		return false;
+
+	if ( m_flNextSecondaryAttack > gpGlobals->curtime || m_flChargeBeginTime > 0 )
+		return false;
+
+	if ( pOwner->GetWaterLevel() == WL_Eyes || !CanAttack() || !CanAirBlast() || !CanAirBlastDeflectProjectile() )
+		return false;
+
+	float flMultAmmoPerShot = 1.0f;
+	CALL_ATTRIB_HOOK_FLOAT( flMultAmmoPerShot, mult_airblast_cost );
+	int iAmmoPerShot = tf_flamethrower_burstammo.GetInt() * flMultAmmoPerShot;
+	if ( pOwner->GetAmmoCount( m_iPrimaryAmmoType ) < iAmmoPerShot )
+		return false;
+
+#ifdef GAME_DLL
+	if ( TFGameRules() && TFGameRules()->IsTruceActive() && pOwner->IsTruceValidForEnt() )
+		return false;
+#endif
+
+	// Find enemy rockets close by and heading at us.
+	const float flRange = tf_mod_autoreflect_range.GetFloat();
+	const Vector vecCenter = pOwner->WorldSpaceCenter();
+	const int iEnemyTeam = GetEnemyTeam( pOwner->GetTeamNumber() );
+
+	CBaseEntity *pList[64];
+#ifdef CLIENT_DLL
+	int nCount = UTIL_EntitiesInSphere( pList, ARRAYSIZE( pList ), vecCenter, flRange, 0 );
+#else
+	int nCount = UTIL_EntitiesInSphere( pList, ARRAYSIZE( pList ), vecCenter, flRange, FL_GRENADE );
+#endif
+
+	CUtlVector< CBaseEntity * > vecIncoming;
+	for ( int i = 0; i < nCount; ++i )
+	{
+		CBaseEntity *pEntity = pList[i];
+		if ( !pEntity || pEntity->GetTeamNumber() != iEnemyTeam || !Mod_IsReflectableRocket( pEntity ) )
+			continue;
+
+		Vector vecVel;
+#ifdef CLIENT_DLL
+		pEntity->EstimateAbsVelocity( vecVel );
+#else
+		vecVel = pEntity->GetAbsVelocity();
+#endif
+		if ( vecVel.NormalizeInPlace() < 1.f )
+			continue;
+
+		// Heading our way, and its path passes within ~body size of us?
+		const Vector vecToMe = vecCenter - pEntity->WorldSpaceCenter();
+		const float flAlong = DotProduct( vecToMe, vecVel );
+		if ( flAlong <= 0.f )
+			continue;
+
+		if ( ( vecToMe - vecVel * flAlong ).LengthSqr() > 100.f * 100.f )
+			continue;
+
+		trace_t tr;
+		UTIL_TraceLine( pOwner->EyePosition(), pEntity->WorldSpaceCenter(), MASK_SOLID_BRUSHONLY, pOwner, COLLISION_GROUP_NONE, &tr );
+		if ( tr.fraction < 1.f )
+			continue;
+
+		vecIncoming.AddToTail( pEntity );
+	}
+
+	if ( !vecIncoming.Count() )
+		return false;
+
+#ifdef GAME_DLL
+	// Send each one where we're aiming, wherever it came from.
+	Vector vecForward;
+	AngleVectors( pOwner->EyeAngles(), &vecForward );
+	bool bDeflected = false;
+	FOR_EACH_VEC( vecIncoming, i )
+	{
+		bDeflected |= DeflectEntity( vecIncoming[i], pOwner, vecForward );
+	}
+	if ( bDeflected )
+	{
+		pOwner->SpeakConceptIfAllowed( MP_CONCEPT_DEFLECTED, "victim:0" );
+		PlayDeflectionSound( false );
+	}
+#endif
+
+	// The airblast itself: animation, sound, ammo, cooldown (and it still pushes
+	// whatever is in front of us, like a normal airblast).
+	FireAirBlast( iAmmoPerShot );
+	return true;
+}
