+
+//=============================================================================
+//
+// MOD: Custom items (scripts/items/items_mod.txt)
+//
+// Items in the mod index range aren't in anyone's Steam inventory, so players
+// equip them from the console:
+//    mod_items                 list custom items
+//    mod_equip <name|index>    equip one (e.g. mod_equip "Bear Arms")
+//    mod_unequip <name|index|all>
+//
+//=============================================================================
+#define MOD_ITEM_INDEX_MIN	38000
+#define MOD_ITEM_INDEX_MAX	39999
+
+static bool Mod_IsModItemIndex( int iDefIndex )
+{
+	return iDefIndex >= MOD_ITEM_INDEX_MIN && iDefIndex <= MOD_ITEM_INDEX_MAX;
+}
+
+static const char *Mod_SlotName( int iSlot )
+{
+	switch ( iSlot )
+	{
+	case LOADOUT_POSITION_PRIMARY:		return "primary";
+	case LOADOUT_POSITION_SECONDARY:	return "secondary";
+	case LOADOUT_POSITION_MELEE:		return "melee";
+	default:							return "other";
+	}
+}
+
+// Accepts a definition index or a definition "name" (case-insensitive).
+static item_definition_index_t Mod_FindItemDef( const char *pszNameOrIndex )
+{
+	if ( !pszNameOrIndex || !*pszNameOrIndex )
+		return INVALID_ITEM_DEF_INDEX;
+
+	const int iIndex = V_atoi( pszNameOrIndex );
+	if ( iIndex > 0 && Mod_IsModItemIndex( iIndex ) && GetItemSchema()->GetItemDefinition( iIndex ) )
+		return (item_definition_index_t)iIndex;
+
+	const CEconItemSchema::ItemDefinitionMap_t &mapDefs = GetItemSchema()->GetItemDefinitionMap();
+	FOR_EACH_MAP_FAST( mapDefs, i )
+	{
+		if ( !Mod_IsModItemIndex( mapDefs.Key( i ) ) )
+			continue;
+
+		if ( !V_stricmp( mapDefs[i]->GetDefinitionName(), pszNameOrIndex ) )
+			return mapDefs.Key( i );
+	}
+
+	return INVALID_ITEM_DEF_INDEX;
+}
+
+// Equips are remembered per Steam account for as long as the server runs,
+// so they survive map changes and reconnects.
+struct ModEquipSave_t
+{
+	item_definition_index_t m_Defs[ TF_CLASS_COUNT_ALL ][ CLASS_LOADOUT_POSITION_COUNT ];
+};
+static CUtlMap< uint32, ModEquipSave_t > s_ModEquipSaves( DefLessFunc( uint32 ) );
+
+void CTFPlayer::Mod_SaveEquips( void )
+{
+	CSteamID steamID;
+	if ( !GetSteamID( &steamID ) || !steamID.IsValid() )
+		return;
+
+	ModEquipSave_t save;
+	V_memcpy( save.m_Defs, m_ModEquippedDefs, sizeof( save.m_Defs ) );
+	s_ModEquipSaves.InsertOrReplace( steamID.GetAccountID(), save );
+}
+
+void CTFPlayer::Mod_RestoreSavedEquips( void )
+{
+	CSteamID steamID;
+	if ( !GetSteamID( &steamID ) || !steamID.IsValid() )
+		return; // not known yet - try again next time
+
+	m_bModEquipsRestored = true;
+
+	const int iSave = s_ModEquipSaves.Find( steamID.GetAccountID() );
+	if ( !s_ModEquipSaves.IsValidIndex( iSave ) )
+		return;
+
+	const ModEquipSave_t &save = s_ModEquipSaves[iSave];
+	for ( int iClass = 0; iClass < TF_CLASS_COUNT_ALL; ++iClass )
+	{
+		for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+		{
+			if ( save.m_Defs[iClass][iSlot] != INVALID_ITEM_DEF_INDEX )
+			{
+				Mod_SetItem( iClass, iSlot, save.m_Defs[iClass][iSlot] );
+			}
+		}
+	}
+}
+
+bool CTFPlayer::Mod_SetItem( int iClass, int iSlot, item_definition_index_t iDefIndex )
+{
+	// Fake, never-reused item IDs well outside the range of real Steam item IDs.
+	static itemid_t s_ulNextModItemID = ( 1ull << 62 );
+
+	CEconItemView &item = m_ModEquippedItems[iClass][iSlot];
+	item.Init( iDefIndex, AE_UNIQUE, AE_USE_SCRIPT_VALUE, false );
+	if ( !item.GetStaticData() )
+	{
+		m_ModEquippedDefs[iClass][iSlot] = INVALID_ITEM_DEF_INDEX;
+		return false;
+	}
+	item.SetItemID( s_ulNextModItemID++ );
+
+	m_ModEquippedDefs[iClass][iSlot] = iDefIndex;
+	return true;
+}
+
+CEconItemView *CTFPlayer::Mod_GetItem( int iClass, int iSlot )
+{
+	if ( !m_bModEquipsRestored )
+	{
+		Mod_RestoreSavedEquips();
+	}
+
+	if ( iClass < 0 || iClass >= TF_CLASS_COUNT_ALL || iSlot < 0 || iSlot >= CLASS_LOADOUT_POSITION_COUNT )
+		return NULL;
+
+	if ( m_ModEquippedDefs[iClass][iSlot] == INVALID_ITEM_DEF_INDEX )
+		return NULL;
+
+	CEconItemView *pItem = &m_ModEquippedItems[iClass][iSlot];
+	return ( pItem->IsValid() && pItem->GetStaticData() ) ? pItem : NULL;
+}
+
+CEconItemView *CTFPlayer::Mod_GetItemByID( itemid_t ulItemID )
+{
+	if ( ulItemID == INVALID_ITEM_ID || ulItemID == 0 )
+		return NULL;
+
+	for ( int iClass = 0; iClass < TF_CLASS_COUNT_ALL; ++iClass )
+	{
+		for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+		{
+			CEconItemView *pItem = Mod_GetItem( iClass, iSlot );
+			if ( pItem && pItem->GetItemID() == ulItemID )
+				return pItem;
+		}
+	}
+	return NULL;
+}
+
+bool CTFPlayer::Mod_EquipItem( item_definition_index_t iDefIndex )
+{
+	GameItemDefinition_t *pDef = static_cast< GameItemDefinition_t * >( GetItemSchema()->GetItemDefinition( iDefIndex ) );
+	if ( !pDef )
+		return false;
+
+	// Equip for the class we're playing if it can use the item, otherwise the first class that can.
+	int iClass = GetPlayerClass() ? GetPlayerClass()->GetClassIndex() : TF_CLASS_UNDEFINED;
+	if ( iClass < TF_FIRST_NORMAL_CLASS || iClass >= TF_LAST_NORMAL_CLASS || !pDef->CanBeUsedByClass( iClass ) )
+	{
+		iClass = TF_CLASS_UNDEFINED;
+		for ( int i = TF_FIRST_NORMAL_CLASS; i < TF_LAST_NORMAL_CLASS; ++i )
+		{
+			if ( pDef->CanBeUsedByClass( i ) )
+			{
+				iClass = i;
+				break;
+			}
+		}
+	}
+	if ( iClass == TF_CLASS_UNDEFINED )
+		return false;
+
+	const int iSlot = pDef->GetLoadoutSlot( iClass );
+	if ( iSlot < 0 || iSlot >= CLASS_LOADOUT_POSITION_COUNT )
+		return false;
+
+	if ( !m_bModEquipsRestored )
+	{
+		Mod_RestoreSavedEquips();
+	}
+
+	if ( !Mod_SetItem( iClass, iSlot, iDefIndex ) )
+		return false;
+
+	Mod_SaveEquips();
+
+	ClientPrint( this, HUD_PRINTCONSOLE, CFmtStr( "Equipped %s for %s (%s).\n", pDef->GetDefinitionName(), g_aPlayerClassNames_NonLocalized[iClass], Mod_SlotName( iSlot ) ) );
+	Mod_ApplyLoadoutChange( iClass );
+	return true;
+}
+
+bool CTFPlayer::Mod_UnequipItem( int iClass, int iSlot )
+{
+	if ( !Mod_GetItem( iClass, iSlot ) )
+		return false;
+
+	m_ModEquippedDefs[iClass][iSlot] = INVALID_ITEM_DEF_INDEX;
+	Mod_SaveEquips();
+	Mod_ApplyLoadoutChange( iClass );
+	return true;
+}
+
+void CTFPlayer::Mod_ApplyLoadoutChange( int iClass )
+{
+	if ( !IsAlive() || !GetPlayerClass() || GetPlayerClass()->GetClassIndex() != iClass )
+		return;
+
+	// Same rule as a normal loadout change: instant in your own spawn room,
+	// otherwise at the next resupply locker or respawn.
+	if ( PointInRespawnRoom( this, WorldSpaceCenter(), true ) )
+	{
+		ForceRegenerateAndRespawn();
+	}
+	else
+	{
+		ClientPrint( this, HUD_PRINTCENTER, "Loadout changed - visit a resupply locker or respawn to use it." );
+	}
+}
+
+// Returns true if the command was one of ours.
+static bool Mod_HandleClientCommand( CTFPlayer *pPlayer, const CCommand &args )
+{
+	const char *pcmd = args[0];
+
+	if ( FStrEq( pcmd, "mod_items" ) )
+	{
+		ClientPrint( pPlayer, HUD_PRINTCONSOLE, "Custom items (use: mod_equip <name or index>):\n" );
+		const CEconItemSchema::ItemDefinitionMap_t &mapDefs = GetItemSchema()->GetItemDefinitionMap();
+		FOR_EACH_MAP_FAST( mapDefs, i )
+		{
+			const int iDefIndex = mapDefs.Key( i );
+			if ( !Mod_IsModItemIndex( iDefIndex ) )
+				continue;
+
+			GameItemDefinition_t *pDef = static_cast< GameItemDefinition_t * >( mapDefs[i] );
+			CUtlString strClasses;
+			for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS; ++iClass )
+			{
+				if ( !pDef->CanBeUsedByClass( iClass ) )
+					continue;
+
+				if ( !strClasses.IsEmpty() )
+					strClasses += ", ";
+				strClasses += CFmtStr( "%s %s", g_aPlayerClassNames_NonLocalized[iClass], Mod_SlotName( pDef->GetLoadoutSlot( iClass ) ) ).Get();
+			}
+
+			const int iMyClass = pPlayer->GetPlayerClass() ? pPlayer->GetPlayerClass()->GetClassIndex() : TF_CLASS_UNDEFINED;
+			CEconItemView *pMine = pPlayer->Mod_GetItem( iMyClass, pDef->GetLoadoutSlot( iMyClass ) );
+			const bool bEquipped = pMine && pMine->GetItemDefIndex() == iDefIndex;
+
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "  %d  \"%s\"  [%s]%s\n", iDefIndex, pDef->GetDefinitionName(), strClasses.Get(), bEquipped ? "  (equipped)" : "" ) );
+		}
+		return true;
+	}
+
+	if ( FStrEq( pcmd, "mod_equip" ) || FStrEq( pcmd, "mod_unequip" ) )
+	{
+		const bool bEquip = FStrEq( pcmd, "mod_equip" );
+		if ( args.ArgC() < 2 )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, bEquip ? "Usage: mod_equip <name or index>   (see mod_items)\n" : "Usage: mod_unequip <name, index or all>\n" );
+			return true;
+		}
+
+		// Allow names with spaces whether or not they were quoted.
+		const char *pszArg = ( args.ArgC() == 2 ) ? args[1] : args.ArgS();
+
+		if ( !bEquip && !V_stricmp( pszArg, "all" ) )
+		{
+			for ( int iClass = 0; iClass < TF_CLASS_COUNT_ALL; ++iClass )
+				for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+					pPlayer->Mod_UnequipItem( iClass, iSlot );
+
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, "Unequipped all custom items.\n" );
+			return true;
+		}
+
+		const item_definition_index_t iDefIndex = Mod_FindItemDef( pszArg );
+		if ( iDefIndex == INVALID_ITEM_DEF_INDEX )
+		{
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "No custom item called \"%s\". Type mod_items for the list.\n", pszArg ) );
+			return true;
+		}
+
+		if ( bEquip )
+		{
+			if ( !pPlayer->Mod_EquipItem( iDefIndex ) )
+			{
+				ClientPrint( pPlayer, HUD_PRINTCONSOLE, CFmtStr( "Couldn't equip \"%s\".\n", pszArg ) );
+			}
+		}
+		else
+		{
+			bool bFound = false;
+			for ( int iClass = 0; iClass < TF_CLASS_COUNT_ALL; ++iClass )
+			{
+				for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+				{
+					CEconItemView *pItem = pPlayer->Mod_GetItem( iClass, iSlot );
+					if ( pItem && pItem->GetItemDefIndex() == iDefIndex )
+					{
+						bFound |= pPlayer->Mod_UnequipItem( iClass, iSlot );
+					}
+				}
+			}
+			ClientPrint( pPlayer, HUD_PRINTCONSOLE, bFound ? CFmtStr( "Unequipped \"%s\".\n", pszArg ).Get() : CFmtStr( "\"%s\" isn't equipped.\n", pszArg ).Get() );
+		}
+		return true;
+	}
+
+	return false;
+}
