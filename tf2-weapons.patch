+//-----------------------------------------------------------------------------
+// MOD: "mod airborne recoil push" (value = speed). Firing while in the air throws you
+// away from where you're aiming - aim down to fly up. Once per jump, like the Force-A-Nature.
+//-----------------------------------------------------------------------------
+void CTFShotgun::FireBullet( CTFPlayer *pPlayer )
+{
+	float flPush = 0.f;
+	CALL_ATTRIB_HOOK_FLOAT( flPush, mod_airborne_recoil_push );
+	if ( flPush > 0.f && pPlayer && !( pPlayer->GetFlags() & FL_ONGROUND ) && !pPlayer->m_Shared.m_bScattergunJump &&
+		 !( TFGameRules() && TFGameRules()->State_Get() == GR_STATE_PREROUND ) )
+	{
+		pPlayer->m_Shared.m_bScattergunJump = true;	// cleared when you land
+
+		Vector vecForward;
+		AngleVectors( pPlayer->EyeAngles(), &vecForward );
+
+		Vector vecVelocity = pPlayer->GetAbsVelocity();
+		if ( vecVelocity.z < 0.f )
+		{
+			vecVelocity.z = 0.f;	// stop the fall first, so aiming down always lifts you
+		}
+		vecVelocity -= vecForward * flPush;
+		pPlayer->SetAbsVelocity( vecVelocity );
+		pPlayer->RemoveFlag( FL_ONGROUND );
+	}
+
+	BaseClass::FireBullet( pPlayer );
+}
