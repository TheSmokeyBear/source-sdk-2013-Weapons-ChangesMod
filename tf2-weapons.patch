+//-----------------------------------------------------------------------------
+// MOD: adds one made-up item per custom item (scripts/items/items_mod.txt) to your
+// item cache on this machine only. They sit on their own pages at the end of your
+// backpack. Calling this again (when Steam re-sends your inventory) just refreshes them.
+//-----------------------------------------------------------------------------
+void CTFPlayerInventory::Mod_AddCustomItemsToCache( GCSDK::CGCClientSharedObjectCache *pSOCache )
+{
+	if ( !pSOCache )
+		return;
+
+	CGCClientSharedObjectTypeCache *pTypeCache = pSOCache->CreateTypeCache( CEconItem::k_nTypeID );
+	if ( !pTypeCache )
+		return;
+
+	const int iFirstPosition = TF_GetAccountBackpackSize( pSOCache ) + 1;
+	int nAdded = 0;
+
+	for ( int iDef = MOD_ITEM_DEF_FIRST; iDef <= MOD_ITEM_DEF_LAST; ++iDef )
+	{
+		CTFItemDefinition *pDef = ItemSystem()->GetStaticDataForItemByDefIndex( (item_definition_index_t)iDef );
+		if ( !pDef || pDef->IsHidden() )
+			continue;
+
+		// Only things a class can actually use.
+		bool bUsable = false;
+		for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS && !bUsable; ++iClass )
+		{
+			const int iSlot = pDef->GetLoadoutSlot( iClass );
+			bUsable = pDef->CanBeUsedByClass( iClass ) && iSlot >= 0 && iSlot < CLASS_LOADOUT_POSITION_COUNT;
+		}
+		if ( !bUsable )
+			continue;
+
+		const int iPosition = iFirstPosition + nAdded;
+		if ( iPosition > (int)kBackendPositionMask_Position )
+			break;
+		++nAdded;
+
+		const itemid_t ulItemID = MOD_INVENTORY_ITEMID_BASE + iDef;
+		CEconItem soIndex;
+		soIndex.SetItemID( ulItemID );
+		CEconItem *pItem = (CEconItem *)pTypeCache->FindSharedObject( soIndex );
+		if ( !pItem )
+		{
+			pItem = new CEconItem;
+			pItem->SetItemID( ulItemID );
+			pTypeCache->AddObject( pItem );
+		}
+
+		int iQuality = pDef->GetQuality();
+		if ( iQuality <= AE_NORMAL || iQuality >= AE_MAX_TYPES )
+		{
+			iQuality = AE_UNIQUE;
+		}
+
+		pItem->SetAccountID( pSOCache->GetOwner().GetAccountID() );
+		pItem->SetDefinitionIndex( iDef );
+		pItem->SetItemLevel( Max( 1, (int)pDef->GetMinLevel() ) );
+		pItem->SetQuality( iQuality );
+		pItem->SetInventoryToken( kBackendPosition_NewFormat | (uint32)iPosition );	// acknowledged, in the backpack at iPosition
+	}
+
+	m_nModItemCount = nAdded;
+}
+
+//-----------------------------------------------------------------------------
+// MOD: something was changed in the loadout menu
+//-----------------------------------------------------------------------------
+void CTFPlayerInventory::Mod_OnLoadoutSlotChanged( int iClass, int iSlot )
+{
+	if ( iClass >= 0 && iClass < TF_CLASS_COUNT && iSlot >= 0 && iSlot < CLASS_LOADOUT_POSITION_COUNT )
+	{
+		m_bModSlotTouched[iClass][iSlot] = true;
+	}
+	m_bModLoadoutDirty = true;
+}
+
+//-----------------------------------------------------------------------------
+// MOD: tells the server which custom items you have equipped in each class's loadout
+// (and which slots you changed in the menu, so it can drop console mod_equip items there).
+//-----------------------------------------------------------------------------
+void CTFPlayerInventory::Mod_SendLoadoutIfDirty( void )
+{
+	if ( !m_bModLoadoutDirty || !m_pSOCache || !RetrievedInventoryFromSteam() )
+		return;
+
+	if ( !engine->IsInGame() || Plat_FloatTime() < m_flModNextSendTime )
+		return;
+
+	m_flModNextSendTime = Plat_FloatTime() + 0.25;
+	m_bModLoadoutDirty = false;
+
+	KeyValues *pKV = new KeyValues( "mod_loadout" );
+	KeyValues *pItemsKV = pKV->FindKey( "items", true );
+	KeyValues *pTouchedKV = pKV->FindKey( "touched", true );
+
+	for ( int iClass = TF_FIRST_NORMAL_CLASS; iClass < TF_LAST_NORMAL_CLASS; ++iClass )
+	{
+		char szClass[16];
+		V_snprintf( szClass, sizeof( szClass ), "%d", iClass );
+
+		for ( int iSlot = 0; iSlot < CLASS_LOADOUT_POSITION_COUNT; ++iSlot )
+		{
+			char szSlot[16];
+			V_snprintf( szSlot, sizeof( szSlot ), "%d", iSlot );
+
+			const itemid_t ulItemID = m_LoadoutItems[iClass][iSlot];
+			if ( Mod_IsInventoryModItemID( ulItemID ) )
+			{
+				CEconItemView *pItem = GetInventoryItemByItemID( ulItemID );
+				if ( pItem && pItem->GetStaticData() )
+				{
+					pItemsKV->FindKey( szClass, true )->SetInt( szSlot, pItem->GetItemDefIndex() );
+				}
+			}
+
+			if ( m_bModSlotTouched[iClass][iSlot] )
+			{
+				pTouchedKV->FindKey( szClass, true )->SetInt( szSlot, 1 );
+			}
+		}
+	}
+
+	memset( m_bModSlotTouched, 0, sizeof( m_bModSlotTouched ) );
+
+	engine->ServerCmdKeyValues( pKV );
 }
 
