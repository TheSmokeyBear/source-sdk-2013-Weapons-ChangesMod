+ConVar tf_mod_dualwield_hide_offhand( "tf_mod_dualwield_hide_offhand", "1", FCVAR_ARCHIVE, "Dual wield: hide each gun's empty left arm so the two arms don't cross on screen." );
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: dual wield - find the top bone of the left arm (bip_hand_L and
+// its parents whose names end in _L, e.g. lowerArm_L, upperArm_L, collar_L).
+//-----------------------------------------------------------------------------
+int CTFViewModel::Mod_FindOffhandRootBone( CStudioHdr *pStudioHdr )
+{
+	if ( GetModel() == m_pModOffhandModel )
+		return m_iModOffhandRoot;
+
+	m_pModOffhandModel = GetModel();
+	m_iModOffhandRoot = -1;
+
+	int iBone = Studio_BoneIndexByName( pStudioHdr, "bip_hand_L" );
+	if ( iBone < 0 )
+	{
+		// Fall back to any bone named "...hand_L"
+		for ( int i = 0; i < pStudioHdr->numbones() && iBone < 0; ++i )
+		{
+			const char *pszName = pStudioHdr->pBone( i )->pszName();
+			int nLen = Q_strlen( pszName );
+			if ( nLen >= 6 && !Q_stricmp( pszName + nLen - 6, "hand_l" ) )
+				iBone = i;
+		}
+	}
+	if ( iBone < 0 )
+		return -1;
+
+	for ( ;; )
+	{
+		int iParent = pStudioHdr->boneParent( iBone );
+		if ( iParent < 0 )
+			break;
+
+		const char *pszName = pStudioHdr->pBone( iParent )->pszName();
+		int nLen = Q_strlen( pszName );
+		if ( nLen < 2 || pszName[nLen - 2] != '_' || ( pszName[nLen - 1] != 'L' && pszName[nLen - 1] != 'l' ) )
+			break;
+
+		iBone = iParent;
+	}
+
+	m_iModOffhandRoot = iBone;
+	return m_iModOffhandRoot;
+}
+
+//-----------------------------------------------------------------------------
+// Purpose: MOD: dual wield - each viewmodel only shows its gun hand. The empty
+// left arm is shrunk to a point at the shoulder, which is off screen.
+//-----------------------------------------------------------------------------
+void CTFViewModel::BuildTransformations( CStudioHdr *pStudioHdr, Vector *pos, Quaternion q[], const matrix3x4_t& cameraTransform, int boneMask, CBoneBitList &boneComputed )
+{
+	BaseClass::BuildTransformations( pStudioHdr, pos, q, cameraTransform, boneMask, boneComputed );
+
+	if ( !pStudioHdr || !tf_mod_dualwield_hide_offhand.GetBool() || !Mod_GetDualWeapon() )
+		return;
+
+	int iRoot = Mod_FindOffhandRootBone( pStudioHdr );
+	if ( iRoot < 0 )
+		return;
+
+	Vector vecShoulder;
+	MatrixGetColumn( GetBone( iRoot ), 3, vecShoulder );
+
+	for ( int i = 0; i < pStudioHdr->numbones(); ++i )
+	{
+		int j = i;
+		while ( j >= 0 && j != iRoot )
+		{
+			j = pStudioHdr->boneParent( j );
+		}
+		if ( j != iRoot )
+			continue;
+
+		matrix3x4_t &bone = GetBoneForWrite( i );
+		MatrixScaleBy( 0.001f, bone );
+		MatrixSetColumn( vecShoulder, 3, bone );
+	}
+}
